{%- liquid
  assign article_schema_url = shop.url | append: article.url
  assign article_schema_body = article.content | replace: '</p>', ' </p>' | strip_html | strip_newlines | strip
  if article.excerpt != blank
    assign article_schema_description = article.excerpt | strip_html | strip_newlines | strip
  elsif article_schema_body != blank
    assign article_schema_description = article_schema_body | truncatewords: 40
  else
    assign article_schema_description = page_description | strip
  endif
-%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "@id": {{ article_schema_url | append: '#article' | json }},
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": {{ article_schema_url | json }}
    },
    "url": {{ article_schema_url | json }},
    "isPartOf": {
      "@id": {{ shop.url | append: '#website' | json }}
    },
    "inLanguage": {{ request.locale.iso_code | json }},
    "headline": {{ article.title | strip | json }},
    "description": {{ article_schema_description | json }}{% if article_schema_body != blank %},
    "articleBody": {{ article_schema_body | json }}{% endif %}{% if article.image %},
    "image": [
      {%- assign image_ratios = '16:9,4:3,1:1' | split: ',' -%}
      {%- for ratio in image_ratios -%}
        {%- liquid
          assign ratio_parts = ratio | split: ':'
          assign ratio_w = ratio_parts[0] | times: 1.0
          assign ratio_h = ratio_parts[1] | times: 1.0
          assign crop_width_from_height = article.image.height | times: ratio_w | divided_by: ratio_h | floor
          assign crop_width = 1200 | at_most: article.image.width | at_most: crop_width_from_height
          assign crop_height = crop_width | times: ratio_h | divided_by: ratio_w | round
        -%}
      {
        "@type": "ImageObject",
        "url": {{ article.image | image_url: width: crop_width, height: crop_height, crop: 'center' | prepend: 'https:' | json }},
        "width": {{ crop_width | json }},
        "height": {{ crop_height | json }}
      }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]{% endif %},
    "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
    "dateCreated": {{ article.created_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
    "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
    "author": {
      "@type": "Person",
      "@id": "https://nudyess.com/#sandra-do-manh",
      "name": "Sandra Do Manh",
      "url": "https://nudyess.com/pages/filozofia-marki-nudyess#sandra-do-manh"
    },
    "publisher": {
      "@id": {{ shop.url | append: '#organization' | json }}
    }{% if article.tags.size > 0 %},
    "keywords": {{ article.tags | join: ', ' | json }}{% endif %}
  }
</script>
  {%- assign article_url = shop.url | append: article.url -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "@id": {{ article_url | append: '#breadcrumb' | json }},
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Strona główna",
          "item": {{ shop.url | append: routes.root_url | json }}
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ blog.title | strip | json }},
          "item": {{ shop.url | append: blog.url | json }}
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": {{ article.title | strip | json }},
          "item": {{ article_url | json }}
        }
      ]
    }
  </script>
{%- if article.metafields.custom.seo_faq != blank -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "@id": {{ shop.url | append: article.url | append: '#faq' | json }},
      "isPartOf": {
        "@id": {{ article_schema_url | append: '#article' | json }}
      },
      "mainEntity": {{ article.metafields.custom.seo_faq.value | json }}
    }
  </script>
{%- endif -%}

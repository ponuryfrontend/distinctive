{%- liquid
	assign overlay_color = block.settings.overlay_color
	assign overlay_opacity = block.settings.overlay_opacity
-%}
<div class="gallery--item" {{ block.shopify_attributes }} style="--overlay-color-rgb: {{ overlay_color.rgb | replace: ' ' , ',' }}; --overlay-opacity: {{ overlay_opacity | divided_by: 100.0 }}">
	<figure class="aspect-ratio">
		{%- if block.settings.image -%}
			{%- liquid
				assign sizes = block.settings.image.width | append: 'x' | append: block.settings.image.height
			-%}
			{%- render 'responsive-image', image: block.settings.image, sizes: sizes -%}
		{%- else -%}
			{{ 'image' | placeholder_svg_tag: 'placeholder_svg_tag' }}
		{%- endif -%}
		<div class="gallery--item-content content-{{ block.settings.content_position }} text-{{ block.settings.text_alignment }}">
			<div>
				{% if block.settings.title != blank %}
					<div class="h3 gallery--item--heading">{{ block.settings.title | replace_first: '|', '<span class="body-font">' | replace: '|', '</span>' }}</div>
				{% endif %}
				{% if block.settings.text != blank %}
					<p>{{ block.settings.text }}</p>
				{% endif %}
				{% if block.settings.link_label != blank %}
					{% if block.settings.use_text_button %}
					<a class="text-button white"{% if block.settings.link == blank %} role="link" aria-disabled="true"{% else %} href="{{ block.settings.link }}"{% endif %} aria-label="{{ block.settings.link_label }}">{{ block.settings.link_label }}</a>
					{% else %}
					<a class="button white outline"{% if block.settings.link == blank %} role="link" aria-disabled="true"{% else %} href="{{ block.settings.link }}"{% endif %} aria-label="{{ block.settings.link_label }}"><span data-content="{{ block.settings.link_label }}"></span></a>
					{% endif %}
				{% endif %}
				{% if block.settings.block_link != blank %}
					<a href="{{ block.settings.block_link }}" class="gallery--item-content-link" target="_blank"></a>
				{% endif %}
			</div>
		</div>
	</figure>
</div>

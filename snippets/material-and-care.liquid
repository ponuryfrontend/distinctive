{%- comment -%}
	Renders the composition and care content of the "Material & Care" block.

	Accepts:
	- product: {Object} Product object.

	Usage:
	{% render 'material-and-care', product: product %}
{%- endcomment -%}
{%- liquid
	assign material_and_care = product.metafields.custom.material_and_care.value
	assign material = material_and_care.material.value
	assign description = material_and_care.description
	assign care_items = material_and_care.care.value
-%}
{%- comment -%}
	The stylesheet is loaded from inside the accordion content on purpose. A <link>
	placed between two accordions would break the `.accordion + .accordion` rule
	that pulls the rows together and leave a double gap above this block.
{%- endcomment -%}
{{- 'material-and-care.css' | asset_url | stylesheet_tag -}}
{%- if material != blank -%}
	<h4 class="material-care__subheading">{{ 'products.product.material_and_care.material' | t }}</h4>
	<p class="material-care__material">{{ material }}</p>
{%- endif -%}
{%- if description != blank or care_items.size > 0 -%}
	<h4 class="material-care__subheading">{{ 'products.product.material_and_care.care' | t }}</h4>
	{%- if description != blank -%}
		<div class="material-care__description">{{ description | metafield_tag }}</div>
	{%- endif -%}
	{%- if care_items.size > 0 -%}
		<ul class="material-care__list">
			{%- for care_item in care_items -%}
				{%- liquid
					comment
						SVG icons return a path relative to the Files page ('files/icon.svg')
						instead of a full CDN URL, so anything that isn't already absolute is
						rebuilt from the file name with file_url.
					endcomment
					assign care_icon = care_item.icon.value
					assign care_label = care_item.description.value | default: care_item.name.value
					assign care_icon_url = care_icon.src | default: care_icon.url
					unless care_icon_url contains '//'
						assign care_icon_file = care_icon_url | split: '/' | last
						assign care_icon_url = ''
						if care_icon_file contains '.'
							assign care_icon_url = care_icon_file | file_url
						endif
					endunless
					unless care_icon_url contains '/'
						assign care_icon_url = ''
					endunless
				-%}
				{%- if care_icon_url != blank or care_label != blank -%}
					<li class="material-care__item">
						<span class="material-care__icon">
							{%- if care_icon_url != blank -%}
								{% # theme-check-disable ImgWidthAndHeight %}
								<img src="{{ care_icon_url }}" alt="" loading="lazy"{% if care_icon.width > 0 and care_icon.height > 0 %} width="{{ care_icon.width }}" height="{{ care_icon.height }}"{% endif %}>
								{% # theme-check-enable ImgWidthAndHeight %}
							{%- endif -%}
						</span>
						<span class="material-care__label">{{ care_label }}</span>
					</li>
				{%- endif -%}
			{%- endfor -%}
		</ul>
	{%- endif -%}
{%- endif -%}

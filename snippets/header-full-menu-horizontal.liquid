<full-menu-horizontal class="full-menu-horizontal">
	<ul class="thb-full-menu" role="menubar">
	  {%- for link in menu.links -%}
		  {%- liquid
				assign parent_index = forloop.index
				assign has_sub_menu = false
				assign has_mega_menu = false

				assign has_menu_badge = false
				assign menu_badge_index = false
				assign menu_badge_blocks = blocks | where: "type", "menu_badge"

				assign has_promotion = false
				assign promotion_block_index = false
				assign promotion_blocks = blocks | where: "type", "promotion"

				assign mega_menu_block_index = false
				assign mega_menu_blocks = blocks | where: "type", "megamenu"

				if link.links.size > 0
					assign has_sub_menu = true
				endif
				for block in mega_menu_blocks
					assign position = block.settings.position | plus: 0
		    	if position == parent_index
						assign has_mega_menu = true
						assign mega_menu_block_index = forloop.index0
					endif
				endfor

				for block in promotion_blocks
					assign position = block.settings.position | plus: 0
					if position == parent_index
						assign has_promotion = true
						assign promotion_block_index = forloop.index0
					endif
				endfor

				for block in menu_badge_blocks
					assign badge_position = block.settings.badge_position | plus: 0
					if badge_position == parent_index
						assign has_menu_badge = true
						assign menu_badge_index = forloop.index0
					endif
				endfor
			-%}
		  <li role="menuitem" class="{% if has_sub_menu or has_mega_menu %}menu-item-has-children{% endif %}{% if has_mega_menu %} menu-item-has-megamenu{% endif %}{% if link.active %} active{% endif %}" {% if has_sub_menu %}data-item-title="{{ link.title | escape }}"{% endif %}>
		    <a href="{{ link.url }}"{%- if link.active %} aria-current="page"{% endif -%}>
					{{- link.title -}}
				</a>
				{%- if has_menu_badge -%}
					{%- assign menu_badge_block = menu_badge_blocks[menu_badge_index] -%}
					<span class="menu-item-badge">{{ menu_badge_block.settings.text }}</span>
				{%- endif -%}
		    {%- if has_sub_menu == true and has_mega_menu == false -%}
					{%- liquid
						assign promotion_block = promotion_blocks[promotion_block_index]
					-%}
			    <div class="sub-menu {%- if has_promotion %} sub-menu--has-promotion{%- endif -%}" tabindex="-1">
						<ul class="sub-menu sub-menu--static">
							{%- for l in link.links -%}
								{%- liquid
									assign has_sub_menu = false
									assign has_mega_menu = false
									if l.links.size > 0
										assign has_sub_menu = true
									endif

								-%}
								<li class="{%- if l.active %}active{% endif %}{% if has_sub_menu %} menu-item-has-children{%- endif -%}" role="none" {% if has_sub_menu %}data-item-title="{{ l.title | escape }}"{% endif %}>
									<a href="{{ l.url }}" role="menuitem">
										{{- l.title -}}
										{%- if has_sub_menu -%}{%- render 'svg-icons' with 'thb-dropdown-right' -%}{%- endif -%}
									</a>
									{%- if has_sub_menu -%}
										<ul class="sub-menu" role="menu">
											{%- for sub_link in l.links -%}
												<li class="{%- if sub_link.active %} active{% endif %}" role="none">
													<a href="{{ sub_link.url }}" role="menuitem">{{- sub_link.title -}}</a>
												</li>
											{%- endfor -%}
										</ul>
									{%- endif -%}
								</li>
							{%- endfor -%}
						</ul>
						{%- if has_promotion -%}
							<div class="mega-menu-promotion">
								<slide-show class="carousel full-menu--promotion-carousel" data-dots="true" data-adapt="true">
									{%- if promotion_block.settings.promo_1_image -%}
									<div class="carousel__slide">
										{% render 'header-full-menu-promotion', promotion_image: promotion_block.settings.promo_1_image, promotion_link: promotion_block.settings.promo_1_link, promotion_heading: promotion_block.settings.promo_1_heading %}
									</div>
									{%- endif -%}
									{%- if promotion_block.settings.promo_2_image -%}
									<div class="carousel__slide">
										{% render 'header-full-menu-promotion', promotion_image: promotion_block.settings.promo_2_image, promotion_link: promotion_block.settings.promo_2_link, promotion_heading: promotion_block.settings.promo_2_heading %}
									</div>
									{%- endif -%}
									{%- if promotion_block.settings.promo_3_image -%}
									<div class="carousel__slide">
										{% render 'header-full-menu-promotion', promotion_image: promotion_block.settings.promo_3_image, promotion_link: promotion_block.settings.promo_3_link, promotion_heading: promotion_block.settings.promo_3_heading %}
									</div>
									{%- endif -%}
									{%- if promotion_block.settings.promo_4_image -%}
									<div class="carousel__slide">
										{% render 'header-full-menu-promotion', promotion_image: promotion_block.settings.promo_4_image, promotion_link: promotion_block.settings.promo_4_link, promotion_heading: promotion_block.settings.promo_4_heading %}
									</div>
									{%- endif -%}
								</slide-show>
							</div>
						{%- endif -%}
			    </div>
		    {%- elsif has_sub_menu == true or has_mega_menu == true -%}
					{%- liquid
						assign mega_menu_block = blocks[mega_menu_block_index]
						assign promotion_block = promotion_blocks[promotion_block_index]
					-%}
					<div class="sub-menu mega-menu-container" tabindex="-1">
				    <ul class="mega-menu-columns" tabindex="-1">
							{%- for l in link.links -%}
								<li class="{% if l.active %} active{% endif %}" role="none">
									<a href="{{ l.url }}" class="mega-menu-columns__heading" role="menuitem">{{ l.title }}</a>
									{%- if l.links.size > 0 -%}
										<ul role="menu">
											{%- for sub_link in l.links -%}
												<li class="{% if sub_link.active %} active{% endif %}" role="none">
													<a href="{{ sub_link.url }}" role="menuitem">{{ sub_link.title }}</a>
												</li>
											{%- endfor -%}
										</ul>
									{%- endif -%}
								</li>
							{%- endfor -%}
				    </ul>
						{%- if has_mega_menu and has_promotion -%}
							<div class="mega-menu-promotion">
								<slide-show class="carousel full-menu--promotion-carousel" data-dots="true" data-adapt="true">
									{%- if promotion_block.settings.promo_1_image -%}
									<div class="carousel__slide">
										{% render 'header-full-menu-promotion', promotion_image: promotion_block.settings.promo_1_image, promotion_link: promotion_block.settings.promo_1_link, promotion_heading: promotion_block.settings.promo_1_heading %}
									</div>
									{%- endif -%}
									{%- if promotion_block.settings.promo_2_image -%}
									<div class="carousel__slide">
										{% render 'header-full-menu-promotion', promotion_image: promotion_block.settings.promo_2_image, promotion_link: promotion_block.settings.promo_2_link, promotion_heading: promotion_block.settings.promo_2_heading %}
									</div>
									{%- endif -%}
									{%- if promotion_block.settings.promo_3_image -%}
									<div class="carousel__slide">
										{% render 'header-full-menu-promotion', promotion_image: promotion_block.settings.promo_3_image, promotion_link: promotion_block.settings.promo_3_link, promotion_heading: promotion_block.settings.promo_3_heading %}
									</div>
									{%- endif -%}
									{%- if promotion_block.settings.promo_4_image -%}
									<div class="carousel__slide">
										{% render 'header-full-menu-promotion', promotion_image: promotion_block.settings.promo_4_image, promotion_link: promotion_block.settings.promo_4_link, promotion_heading: promotion_block.settings.promo_4_heading %}
									</div>
									{%- endif -%}
								</slide-show>
							</div>
						{%- endif -%}
					</div>
		    {%- endif -%}
		  </li>
	  {%- endfor -%}
	</ul>
	<div class="full-menu--cc"></div>
</full-menu-horizontal>

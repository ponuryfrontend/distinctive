{%- if product_card_product and product_card_product != empty -%}
{% liquid
	assign products_hover_images = settings.products_hover_images
	assign product_aspect_ratio = settings.product_aspect_ratio
	assign featured_media = product_card_product.featured_media
	assign ratio = 1
	assign sizes = '375x375,770x770'
	assign is_video = false
	assign use_video = settings.products_use_video

	if featured_media.media_type != 'image'
		if featured_media.media_type == 'video' and use_video
			assign is_video = true
			assign featured_media = featured_media
		else
			assign featured_media = featured_media.preview_image
		endif
	endif
	if product_aspect_ratio == 'adapt'
		assign ratio = featured_media.aspect_ratio
		assign sizes = '375x0,770x0'
	elsif product_aspect_ratio == 'portrait'
		assign ratio = 1 | divided_by: 1.25
		assign sizes = '375x350,770x700'
	elsif product_aspect_ratio == 'landscape'
		assign ratio = 1 | divided_by: 0.75
		assign sizes = '375x250,770x500'
	endif
	assign product_content_alignment = settings.product_content_alignment

	# Product card options
	assign show_size_options = settings.show_size_options
	assign size_options_variant_name = settings.size_options_variant_name
	assign size_options_limit = settings.size_options_limit
	assign show_products_vendor = settings.show_products_vendor

	# is it purchasable?
	assign is_purchasable = false
	if product_card_product.available and product_card_product.variants.size == 1
		assign is_purchasable = true
	endif

	# pre-compute on_sale to avoid repeated compare_at_price resolution in child snippets
	assign product_on_sale = false
	if product_card_product.compare_at_price > product_card_product.price and product_card_product.available
		assign product_on_sale = true
	endif
-%}
<product-card class="product-card text-{{ product_content_alignment }}">
  <figure class="product-featured-image {% if products_hover_images and product_card_product.images.size > 1 %}thb-hover{% endif %}">
    {% render 'product-card-badge', product_card_product: product_card_product, product_on_sale: product_on_sale %}
    <a href="{{ product_card_product.url | within: collection }}" title="{{ product_card_product.title | escape }}" class="product-featured-image-link aspect-ratio aspect-ratio--{{ settings.product_aspect_ratio }}{% if product_card_product.images.size > 1 %} has-multiple-images{% endif %}" style="--padding-bottom: {{ 1 | divided_by: ratio | times: 100 }}%; --aspect-ratio: {{ ratio }};">
			{%- if featured_media -%}
				{%- if is_video and use_video -%}
					{{ featured_media | video_tag: controls: false, loading: 'lazy', loop: true, autoplay: true, image_size: '770x' }}
				{%- else -%}
      	{%- render 'responsive-image', class: 'product-primary-image', image: featured_media, sizes: sizes, priority: priority -%}
				{%- endif -%}
			{%- else -%}
				<div class="thb-placeholder">
					{{ 'product-1' | placeholder_svg_tag }}
				</div>
			{%- endif -%}
			{%- if product_card_product.images.size > 1 -%}
				{%- render 'responsive-image', class: 'product-secondary-image', image: product_card_product.images[1], sizes: sizes, priority: 'low' -%}
			{%- endif -%}
			{%- if settings.enable_quick_view -%}
			<quick-view class="product-card-quickview" data-product-handle="{{ product_card_product.handle }}" tabindex="-1">
				{% render 'svg-icons' with 'quick-view' %}
				{% render 'svg-icons' with 'thb-loading' %}
				<span>{{ 'products.product.quick_view' | t }}</span>
			</quick-view>
			{%- endif -%}
			{%- if settings.enable_quick_add -%}
				{%- liquid
					assign is_preorder_button = false
					if product_card_product.selected_or_first_available_variant.available == false
						assign button_content = 'products.product.sold_out' | t
					else
						if product_card_product.metafields.theme.preorder and product_card_product.available
							assign is_preorder_button = true
							assign button_content = 'products.product.pre_order' | t
						else
							assign button_content = 'products.product.add_to_cart' | t
						endif
					endif
				-%}
				<quick-view class="product-card-quickview product-card--add-to-cart-button{% if is_purchasable %} product-card--add-to-cart-button-simple{% endif %}{% if is_preorder_button %} product-card--add-to-cart-button-preorder{% endif %}" data-product-handle="{{ product_card_product.handle }}" data-product-id="{{ product_card_product.selected_or_first_available_variant.id }}" tabindex="-1" {% if product_card_product.selected_or_first_available_variant.available == false %}disabled{% endif %}>
					{% render 'svg-icons' with 'quick-add-to-cart' %}
					{% render 'svg-icons' with 'thb-loading' %}
					<span class="product-card--add-to-cart-label-default">{{ button_content }}</span>
					{%- if is_preorder_button -%}
						<span class="product-card--add-to-cart-label-hover">{{ 'products.product.add_to_cart' | t }}</span>
					{%- endif -%}
				</quick-view>
			{%- endif -%}
    </a>
		{%- if product_card_product.images.size > 1 -%}
		<div class="product-card-indicators">
			<span class="product-card-indicator is-active"></span>
			<span class="product-card-indicator"></span>
		</div>
		{%- endif -%}
		{% render 'product-card-swatch', product: product_card_product, sizes: sizes %}
  </figure>
	<div class="product-card-info">
		{%- if show_products_vendor -%}
		<div class="product-card-vendor"><a href="{{ product_card_product.vendor | url_for_vendor }}" title="{{ product_card_product.vendor | escape }}">{{ product_card_product.vendor }}</a></div>
		{%- endif -%}
  	<a href="{{ product_card_product.url | within: collection }}" title="{{ product_card_product.title | escape }}" class="product-card-title">{{ product_card_product.title }}</a>
    {% render 'product-price', product: product_card_product %}
		{%- if show_size_options -%}
			{%- render 'product-card-size-options', product_card_product: product_card_product, size_options_variant_name: size_options_variant_name, size_options_limit: size_options_limit -%}
		{%- endif -%}
		{%- if settings.show_products_rating and product_card_product.metafields.reviews.rating.value != blank -%}
		<div class="star-rating" style="--star-rating: {{ product_card_product.metafields.reviews.rating.value.rating }};"></div>
		{%- endif -%}
		{%- render 'product-card-labels', product: product_card_product -%}
  </div>
</product-card>
{%- else -%}
<product-card class="product-card">
	<figure class="product-featured-image {% if settings.products_hover_images %}thb-hover{% endif %}">
		<a href="{{ product_card_product.url | within: collection }}" title="{{ product_card_product.title | escape }}" class="product-featured-image-link aspect-ratio aspect-ratio--{{ settings.product_aspect_ratio }}" style="--padding-bottom: {{ 1 | divided_by: 1 | times: 100 }}%;">
			<div class="thb-placeholder">
				{{ 'product-1' | placeholder_svg_tag }}
			</div>
			{%- if settings.enable_quick_view -%}
			<quick-view class="product-card-quickview" data-product-handle="{{ product_card_product.handle }}" tabindex="-1">
				{% render 'svg-icons' with 'quick-view' %}
				{% render 'svg-icons' with 'thb-loading' %}
				<span>{{ 'products.product.quick_view' | t }}</span>
			</quick-view>
			{%- endif -%}
			{%- if settings.enable_quick_add -%}
			<quick-view class="product-card-quickview product-card--add-to-cart-button" data-product-handle="" tabindex="-1" disabled>
				{% render 'svg-icons' with 'quick-add-to-cart' %}
				{% render 'svg-icons' with 'thb-loading' %}
				<span>{{ 'products.product.choose_options' | t }}</span>
			</quick-view>
		{%- endif -%}
		</a>
	</figure>
	<div class="product-card-info">
		<div class="product-card-vendor"><a href="#" title="{{ 'onboarding.product_vendor' | t }}">{{ 'onboarding.product_vendor' | t }}</a></div>
		<a href="#" title="{{ product_card_product.title | escape }}" class="product-card-title">{{ 'onboarding.product_title' | t }}</a>
		{% render 'product-price', product: product_card_product %}
		{%- if settings.show_products_rating and product_card_product.metafields.reviews.rating.value != blank -%}
		<div class="star-rating" style="--star-rating: 5;"></div>
		{%- endif -%}
		
	</div>
</product-card>
{%- endif -%}

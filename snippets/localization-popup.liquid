<modal-dialog id="LocalizationModal--locale" class="thb-localization-forms-modal" data-moved="true">
  <div role="dialog" aria-modal="true" class="thb-localization-forms-modal__content" tabindex="-1">
    <div class="thb-localization-forms-modal__content-header">
      <span class="h5 body-font">Select your locale</span>
      <button id="ModalClose-LocalizationModal--locale" type="button" class="thb-localization-forms-modal__toggle" aria-label="{{ 'accessibility.close' | t }}">{% render 'svg-icons' with 'close' %}</button>
    </div>
    <div class="thb-localization-forms-modal__content-info">
      {% assign language_switcher_text = settings.language_switcher_text %}
      {% unless language_switcher_text == '' %}
      <p>{{ language_switcher_text | replace: '%language_name%', localization.language.endonym_name }}</p>
      {% endunless %}
      {%- form 'localization', id: 'LocalizationModal--locale-form' -%}
        <div class="select">
          <select name="locale_code" class="thb-language-code full">
            {%- for language in localization.available_languages -%}
              <option value="{{ language.iso_code }}" {%- if language == localization.language %} selected="selected"{% endif %}>{{- language.endonym_name -}}</option>
            {%- endfor -%}
          </select>
          <div class="select-arrow">{%- render 'svg-icons' with 'thb-select' -%}</div>
        </div>
        <button class="button"><span data-content="{{ 'localization.update_language' | t }}"></span></button>
      {%- endform -%}
    </div>
  </div>
</modal-dialog>
<modal-dialog id="LocalizationModal--country" class="thb-localization-forms-modal" data-moved="true">
  <div role="dialog" aria-modal="true" class="thb-localization-forms-modal__content" tabindex="-1">
    <div class="thb-localization-forms-modal__content-header">
      <span class="h5 body-font">Select your country</span>
      <button id="ModalClose-LocalizationModal--country" type="button" class="thb-localization-forms-modal__toggle" aria-label="{{ 'accessibility.close' | t }}">{% render 'svg-icons' with 'close' %}</button>
    </div>
    <div class="thb-localization-forms-modal__content-info">
      {% assign currency_switcher_text = settings.currency_switcher_text %}
      {% unless currency_switcher_text == '' %}
      <p>{{ currency_switcher_text | replace: '%country_name%', localization.country | replace: '%currency_code%', localization.country.currency.iso_code }}</p>
      {% endunless %}
      {%- form 'localization', id: 'LocalizationModal--country-form' -%}
      <div class="select">
        <select name="country_code" class="thb-currency-code full">
          {%- for country in localization.available_countries -%}
            <option value="{{ country.iso_code }}" {%- if country.iso_code == localization.country.iso_code %} selected="selected"{% endif %}>{{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})</option>
          {%- endfor -%}
        </select>
        <div class="select-arrow">{%- render 'svg-icons' with 'thb-select' -%}</div>
      </div>
      <button class="button"><span data-content="{{ 'localization.update_country' | t }}"></span></button>
      {%- endform -%}
    </div>
  </div>
</modal-dialog>
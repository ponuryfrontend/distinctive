{%- comment -%}
  ============================================================================
  SIZE GUIDE — SYLWETKI / size-guide-silhouettes.liquid
  ============================================================================
  Prosta grafika liniowa (flat-lay) danego typu odzieży, używana wewnątrz
  panelu „Sprawdź rozmiar" (snippets/size-guide.liquid).

  PARAMETRY:
    silhouette : 'top' | 'shirt' | 'jacket' | 'coat' | 'dress' | 'jumpsuit'
                 | 'trousers' | 'shorts' | 'skirt' | 'custom'
    custom_svg : surowy markup <svg> z metafieldu (używany gdy silhouette == 'custom')

  Każda grupa `.sg-svg__dim[data-point="…"]` odpowiada kluczowi pomiaru
  używanemu w size-guide.liquid / size-guide.js — zamknięty zestaw:
  bust, waist, hips, sleeve, length. JS podświetla właściwą grupę
  po najechaniu / focusie na wiersz tabeli pomiarów.

  WYWOŁANIE:  {%- render 'size-guide-silhouettes', silhouette: silhouette, custom_svg: custom_svg -%}
  ============================================================================
{%- endcomment -%}

{%- liquid
  assign s = silhouette | default: 'top'
-%}

<div class="sg-svg">
  {%- if s == 'custom' and custom_svg != blank -%}

    <div class="sg-svg__art">{{ custom_svg }}</div>

  {%- elsif s == 'trousers' -%}

    <svg class="sg-svg__art" viewBox="0 0 130 150" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-hidden="true">
      <path class="sg-svg__garment" d="M34,15 L86,15 L92,52 L78,130 L64,130 L60,58 L56,130 L42,130 L28,52 Z" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"/>
      <g class="sg-svg__dims">
        <g class="sg-svg__dim" data-point="waist">
          <line x1="36" y1="18" x2="84" y2="18"/><line x1="36" y1="15" x2="36" y2="21"/><line x1="84" y1="15" x2="84" y2="21"/>
          <text x="88" y="21">Talia</text>
        </g>
        <g class="sg-svg__dim" data-point="hips">
          <line x1="30" y1="52" x2="90" y2="52"/><line x1="30" y1="49" x2="30" y2="55"/><line x1="90" y1="49" x2="90" y2="55"/>
          <text x="94" y="55">Biodra</text>
        </g>
        <g class="sg-svg__dim" data-point="length">
          <line x1="110" y1="15" x2="110" y2="130"/><line x1="107" y1="15" x2="113" y2="15"/><line x1="107" y1="130" x2="113" y2="130"/>
          <text x="114" y="75">Długość</text>
        </g>
      </g>
    </svg>

  {%- elsif s == 'shorts' -%}

    <svg class="sg-svg__art" viewBox="0 0 130 150" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-hidden="true">
      <path class="sg-svg__garment" d="M34,15 L86,15 L92,45 L74,70 L60,50 L46,70 L28,45 Z" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"/>
      <g class="sg-svg__dims">
        <g class="sg-svg__dim" data-point="waist">
          <line x1="36" y1="18" x2="84" y2="18"/><line x1="36" y1="15" x2="36" y2="21"/><line x1="84" y1="15" x2="84" y2="21"/>
          <text x="88" y="21">Talia</text>
        </g>
        <g class="sg-svg__dim" data-point="hips">
          <line x1="30" y1="45" x2="90" y2="45"/><line x1="30" y1="42" x2="30" y2="48"/><line x1="90" y1="42" x2="90" y2="48"/>
          <text x="94" y="48">Biodra</text>
        </g>
        <g class="sg-svg__dim" data-point="length">
          <line x1="110" y1="15" x2="110" y2="70"/><line x1="107" y1="15" x2="113" y2="15"/><line x1="107" y1="70" x2="113" y2="70"/>
          <text x="114" y="45">Długość</text>
        </g>
      </g>
    </svg>

  {%- elsif s == 'skirt' -%}

    <svg class="sg-svg__art" viewBox="0 0 130 150" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-hidden="true">
      <path class="sg-svg__garment" d="M34,15 L86,15 L94,45 L100,110 L20,110 L26,45 Z" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"/>
      <g class="sg-svg__dims">
        <g class="sg-svg__dim" data-point="waist">
          <line x1="36" y1="18" x2="84" y2="18"/><line x1="36" y1="15" x2="36" y2="21"/><line x1="84" y1="15" x2="84" y2="21"/>
          <text x="88" y="21">Talia</text>
        </g>
        <g class="sg-svg__dim" data-point="hips">
          <line x1="28" y1="45" x2="92" y2="45"/><line x1="28" y1="42" x2="28" y2="48"/><line x1="92" y1="42" x2="92" y2="48"/>
          <text x="96" y="48">Biodra</text>
        </g>
        <g class="sg-svg__dim" data-point="length">
          <line x1="110" y1="15" x2="110" y2="110"/><line x1="107" y1="15" x2="113" y2="15"/><line x1="107" y1="110" x2="113" y2="110"/>
          <text x="114" y="65">Długość</text>
        </g>
      </g>
    </svg>

  {%- elsif s == 'dress' -%}

    <svg class="sg-svg__art" viewBox="0 0 130 190" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-hidden="true">
      <path class="sg-svg__garment" d="M50,14 L70,14 L82,20 L94,34 L86,46 L78,38 L82,80 L100,175 L20,175 L38,80 L42,38 L34,46 L26,34 L38,20 Z" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"/>
      <g class="sg-svg__dims">
        <g class="sg-svg__dim" data-point="bust">
          <line x1="42" y1="48" x2="78" y2="48"/><line x1="42" y1="45" x2="42" y2="51"/><line x1="78" y1="45" x2="78" y2="51"/>
          <text x="82" y="51">Biust</text>
        </g>
        <g class="sg-svg__dim" data-point="waist">
          <line x1="38" y1="80" x2="82" y2="80"/><line x1="38" y1="77" x2="38" y2="83"/><line x1="82" y1="77" x2="82" y2="83"/>
          <text x="86" y="83">Talia</text>
        </g>
        <g class="sg-svg__dim" data-point="hips">
          <line x1="34" y1="100" x2="86" y2="100"/><line x1="34" y1="97" x2="34" y2="103"/><line x1="86" y1="97" x2="86" y2="103"/>
          <text x="90" y="103">Biodra</text>
        </g>
        <g class="sg-svg__dim" data-point="length">
          <line x1="114" y1="14" x2="114" y2="175"/><line x1="111" y1="14" x2="117" y2="14"/><line x1="111" y1="175" x2="117" y2="175"/>
          <text x="118" y="97">Długość</text>
        </g>
      </g>
    </svg>

  {%- elsif s == 'jumpsuit' -%}

    <svg class="sg-svg__art" viewBox="0 0 130 190" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-hidden="true">
      <path class="sg-svg__garment" d="M50,14 L70,14 L84,20 L98,36 L88,48 L78,38 L84,95 L100,185 L86,185 L64,100 L64,185 L56,185 L56,100 L34,185 L20,185 L36,95 L42,38 L32,48 L22,36 L36,20 Z" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"/>
      <g class="sg-svg__dims">
        <g class="sg-svg__dim" data-point="bust">
          <line x1="40" y1="50" x2="80" y2="50"/><line x1="40" y1="47" x2="40" y2="53"/><line x1="80" y1="47" x2="80" y2="53"/>
          <text x="84" y="53">Biust</text>
        </g>
        <g class="sg-svg__dim" data-point="waist">
          <line x1="42" y1="80" x2="78" y2="80"/><line x1="42" y1="77" x2="42" y2="83"/><line x1="78" y1="77" x2="78" y2="83"/>
          <text x="82" y="83">Talia</text>
        </g>
        <g class="sg-svg__dim" data-point="hips">
          <line x1="36" y1="95" x2="84" y2="95"/><line x1="36" y1="92" x2="36" y2="98"/><line x1="84" y1="92" x2="84" y2="98"/>
          <text x="88" y="98">Biodra</text>
        </g>
        <g class="sg-svg__dim" data-point="length">
          <line x1="112" y1="14" x2="112" y2="185"/><line x1="109" y1="14" x2="115" y2="14"/><line x1="109" y1="185" x2="115" y2="185"/>
          <text x="116" y="100">Długość</text>
        </g>
      </g>
    </svg>

  {%- elsif s == 'jacket' or s == 'coat' -%}

    {%- assign hem_y = 130 -%}
    {%- if s == 'coat' -%}
      {%- assign hem_y = 175 -%}
    {%- endif -%}

    <svg class="sg-svg__art" viewBox="0 0 130 190" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-hidden="true">
      <path class="sg-svg__garment" d="M42,12 L60,22 L78,12 L86,20 L106,44 L96,100 L84,92 L80,38 L84,{{ hem_y }} L36,{{ hem_y }} L40,38 L36,92 L24,100 L14,44 L34,20 Z" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"/>
      <g class="sg-svg__dims">
        <g class="sg-svg__dim" data-point="bust">
          <line x1="38" y1="48" x2="82" y2="48"/><line x1="38" y1="45" x2="38" y2="51"/><line x1="82" y1="45" x2="82" y2="51"/>
          <text x="86" y="51">Biust</text>
        </g>
        <g class="sg-svg__dim" data-point="sleeve">
          <line x1="114" y1="20" x2="114" y2="100"/><line x1="111" y1="20" x2="117" y2="20"/><line x1="111" y1="100" x2="117" y2="100"/>
          <text x="118" y="62">Rękaw</text>
        </g>
        <g class="sg-svg__dim" data-point="length">
          <line x1="124" y1="12" x2="124" y2="{{ hem_y }}"/><line x1="121" y1="12" x2="127" y2="12"/><line x1="121" y1="{{ hem_y }}" x2="127" y2="{{ hem_y }}"/>
          <text x="4" y="10">Długość</text>
        </g>
      </g>
    </svg>

  {%- elsif s == 'shirt' -%}

    <svg class="sg-svg__art" viewBox="0 0 130 190" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-hidden="true">
      <path class="sg-svg__garment" d="M46,10 L74,10 L80,20 L104,46 L94,108 L82,100 L78,40 L82,150 L38,150 L42,40 L38,100 L26,108 L16,46 L40,20 Z" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"/>
      <g class="sg-svg__dims">
        <g class="sg-svg__dim" data-point="bust">
          <line x1="42" y1="52" x2="78" y2="52"/><line x1="42" y1="49" x2="42" y2="55"/><line x1="78" y1="49" x2="78" y2="55"/>
          <text x="82" y="55">Biust</text>
        </g>
        <g class="sg-svg__dim" data-point="sleeve">
          <line x1="114" y1="20" x2="114" y2="108"/><line x1="111" y1="20" x2="117" y2="20"/><line x1="111" y1="108" x2="117" y2="108"/>
          <text x="118" y="66">Rękaw</text>
        </g>
        <g class="sg-svg__dim" data-point="length">
          <line x1="124" y1="10" x2="124" y2="150"/><line x1="121" y1="10" x2="127" y2="10"/><line x1="121" y1="150" x2="127" y2="150"/>
          <text x="4" y="8">Długość</text>
        </g>
      </g>
    </svg>

  {%- else -%}

    {%- comment -%} fallback: 'top' {%- endcomment -%}
    <svg class="sg-svg__art" viewBox="0 0 130 190" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-hidden="true">
      <path class="sg-svg__garment" d="M50,14 L70,14 L84,20 L98,36 L88,48 L78,38 L82,120 L38,120 L42,38 L32,48 L22,36 L36,20 Z" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"/>
      <g class="sg-svg__dims">
        <g class="sg-svg__dim" data-point="bust">
          <line x1="40" y1="50" x2="80" y2="50"/><line x1="40" y1="47" x2="40" y2="53"/><line x1="80" y1="47" x2="80" y2="53"/>
          <text x="84" y="53">Biust</text>
        </g>
        <g class="sg-svg__dim" data-point="length">
          <line x1="114" y1="14" x2="114" y2="120"/><line x1="111" y1="14" x2="117" y2="14"/><line x1="111" y1="120" x2="117" y2="120"/>
          <text x="118" y="70">Długość</text>
        </g>
      </g>
    </svg>

  {%- endif -%}
</div>

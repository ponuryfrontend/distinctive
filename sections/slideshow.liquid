{%- liquid
	assign desktop_height = section.settings.desktop_height
	assign mobile_height = section.settings.mobile_height
	assign desktop_height_custom = section.settings.desktop_height_custom
	assign mobile_height_custom = section.settings.mobile_height_custom
	assign transition = section.settings.transition
	
	assign change_header = section.settings.change_header
	assign autoplay = section.settings.autoplay
	assign dot_style = section.settings.dot_style
	assign dot_alignment = section.settings.dot_alignment
	assign disable_top_spacing = section.settings.disable_top_spacing
	assign disable_bottom_spacing = section.settings.disable_bottom_spacing
 	assign dots = true
	if section.blocks.size < 2
		assign dots = false
	endif

	if autoplay
		assign autoplay = section.settings.autoplay_length | times: 1000
	endif

	case mobile_height
		when 'mobile-height-400'
			assign mobile_image_height = 400
		when 'mobile-height-450'
			assign mobile_image_height = 450
		when 'mobile-height-500'
			assign mobile_image_height = 500
		when 'mobile-height-custom'
			assign mobile_image_height = mobile_height_custom
		else
			assign mobile_image_height = 500
	endcase

	assign fade = true
	if transition == 'slide'
		assign fade = false
	endif

	assign first_color = section.blocks[0].settings.color_text

	assign preload = false
	if section.index == 1
		assign preload = true
	endif
-%}
{%- capture height_style -%}
	{%- if desktop_height == 'desktop-height-custom' -%}--desktop-height-custom: {{ desktop_height_custom }}px;{%- endif -%}
	{%- if mobile_height == 'mobile-height-custom' -%}--mobile-height-custom: {{ mobile_height_custom }}px;{%- endif -%}
{%- endcapture -%}
{{- 'slideshow.css' | asset_url | stylesheet_tag: preload: preload -}}
<slide-show class="slideshow main-slideshow carousel{% if dot_style == 'titles' %} custom-dots{%- endif %} change-header--{{ change_header }} {{ mobile_height }} {{ desktop_height }} section-spacing{% if disable_top_spacing %} section-spacing--disable-top{% endif %}{% if disable_bottom_spacing %} section-spacing--disable-bottom{% endif %} transition--{{ transition }} dots--{{ dot_alignment }}" data-dots="{{ dots }}" data-autoplay="{{ autoplay }}" data-fade="{{ fade }}" data-transition="{{ transition }}" style="--dot-speed: {{ autoplay | divided_by: 1000 | append: 's' }}; --color-text: {{ first_color }}; --color-text-rgb: {{ first_color.rgb | replace: ' ' , ',' }};{{ height_style | strip_newlines | strip }}" data-section-index="{{ section.index }}">
	{%- for block in section.blocks -%}
		{%- liquid
			assign content_position = block.settings.content_position
			assign text_alignment = block.settings.text_alignment
			assign content_size = block.settings.content_size
			assign overlay_color = block.settings.overlay_color
			assign overlay_opacity = block.settings.overlay_opacity
			assign color_text = block.settings.color_text

			assign subheading_size_d = block.settings.subheading_font_size_desktop
			assign subheading_size_m = block.settings.subheading_font_size_mobile
			assign heading_font_size_d = block.settings.heading_font_size_desktop
			assign heading_font_size_m = block.settings.heading_font_size_mobile
			assign description_font_size_d = block.settings.description_font_size_desktop
			assign description_font_size_m = block.settings.description_font_size_mobile

			if forloop.index == 1 and preload
				assign priority = 'high'
			endif
		-%}
		{%- capture subheading_classes -%}
			{%- if subheading_size_d > 0 %} subheading--size-desktop{% endif -%}
			{%- if subheading_size_m > 0 %} subheading--size-mobile{% endif -%}
		{%- endcapture -%}
		{%- capture subheading_style -%}
			{%- if subheading_size_d > 0 -%}--subheading-size-desktop: {{ subheading_size_d }}px;{%- endif -%}
			{%- if subheading_size_m > 0 -%}--subheading-size-mobile: {{ subheading_size_m }}px;{%- endif -%}
		{%- endcapture -%}
		{%- capture heading_font_classes -%}
			{%- if heading_font_size_d > 0 %} slideshow__slide-heading--size-desktop{% endif -%}
			{%- if heading_font_size_m > 0 %} slideshow__slide-heading--size-mobile{% endif -%}
		{%- endcapture -%}
		{%- capture heading_font_style -%}
			{%- if heading_font_size_d > 0 -%}--slideshow-heading-size-desktop: {{ heading_font_size_d }}px;{%- endif -%}
			{%- if heading_font_size_m > 0 -%}--slideshow-heading-size-mobile: {{ heading_font_size_m }}px;{%- endif -%}
		{%- endcapture -%}
		{%- capture description_font_classes -%}
			{%- if description_font_size_d > 0 %} slideshow__slide-description--size-desktop{% endif -%}
			{%- if description_font_size_m > 0 %} slideshow__slide-description--size-mobile{% endif -%}
		{%- endcapture -%}
		{%- capture description_font_style -%}
			{%- if description_font_size_d > 0 -%}--slideshow-description-size-desktop: {{ description_font_size_d }}px;{%- endif -%}
			{%- if description_font_size_m > 0 -%}--slideshow-description-size-mobile: {{ description_font_size_m }}px;{%- endif -%}
		{%- endcapture -%}
		<div class="slideshow__slide carousel__slide {{ mobile_height }} {{ desktop_height }} text-{{ text_alignment }} content-size-{{ content_size }}{% if forloop.index == 1 %} is-initial-selected{% endif %}" style="--color-text: {{ color_text }}; --color-text-rgb: {{ color_text.rgb | replace: ' ' , ',' }}; --overlay-color-rgb: {{ overlay_color.rgb | replace: ' ' , ',' }}; --overlay-opacity: {{ overlay_opacity | divided_by: 100.0 }};" {{ block.shopify_attributes }}>
			{%- if desktop_height == 'desktop-height-image' or mobile_height == 'mobile-height-image' -%}
				<div class="slideshow__slide-adapt-to-image">
					{%- if block.settings.image -%}
						{%- liquid
							assign image = block.settings.image
							assign master_width = image.src.width | append: 'x' | append: image.src.height
							assign width = '375x' | append: mobile_image_height | append: ',' | append: master_width

							assign class = ''
							if block.settings.mobile_image
								assign class = 'slideshow-image--desktop'
							endif
							-%}
							<img data-src="{{ image | image_url }}" class="lazyload {{ class }}{% unless settings.lazy_loading %} no-blur{% endunless %}" width="{{ image.src.width }}" height="{{ image.src.height }}" alt="{{ image.alt }}" />
					{%- else -%}
						{%- assign index = forloop.index | modulo: 2 | plus: 1 -%}
						{{ 'hero-apparel-' | append: index | placeholder_svg_tag: 'placeholder_svg_tag' }}
					{%- endif -%}
					{%- if block.settings.mobile_image -%}
						{%- liquid
							assign image = block.settings.mobile_image
							assign master_width = image.src.width | append: 'x' | append: image.src.height
							assign width = '375x' | append: mobile_image_height | append: ',' | append: master_width
							-%}
						<img data-src="{{ image | image_url }}" class="lazyload slideshow-image--mobile{% unless settings.lazy_loading %} no-blur{% endunless %}" width="{{ image.src.width }}" height="{{ image.src.height }}" alt="{{ image.alt }}" />
					{%- endif -%}
				</div>
			{%- endif -%}
			<div class="slideshow__slide-bg">
				{%- if block.settings.image -%}
					{%- liquid
						assign image = block.settings.image
						assign master_width = image.src.width | append: 'x' | append: image.src.height
						assign variable_widths = '900x,1000x,1100x,1200x,1400x,1600x,' | append: master_width
						assign width = '375x' | append: mobile_image_height | append: ',' | append: master_width
						assign class = nil

						if block.settings.mobile_image != blank
							assign class = 'slideshow-image--desktop'
							assign width = variable_widths
						endif
						-%}
					{%- render 'responsive-image', image: image, sizes: width, class: class, priority: priority -%}
				{%- else -%}
					{%- assign index = forloop.index | modulo: 2 | plus: 1 -%}
					{{ 'hero-apparel-' | append: index | placeholder_svg_tag: 'placeholder_svg_tag' }}
				{%- endif -%}
				{%- if block.settings.mobile_image != blank -%}
					{%- liquid
						assign image = block.settings.mobile_image
						assign master_width = image.src.width | append: 'x' | append: image.src.height
						assign width = '375x' | append: mobile_image_height | append: ',' | append: master_width
						-%}
					{%- render 'responsive-image', image: image, sizes: width, class: 'slideshow-image--mobile', priority: priority -%}
				{%- endif -%}
			</div>
			{%- if block.settings.video_background -%}
				{%- if block.settings.video_hosted != blank -%}
					{%- liquid
						assign video = block.settings.video_hosted
						assign autoplay = false
						if forloop.index == 1
							assign autoplay = true
						endif
					-%}
					<div class="slideshow__slide-video-bg" data-provider="hosted" data-video-id="{{ video.id }}">
						{{ video | video_tag: autoplay: autoplay, loop: true, controls: false, muted: true, image_size: '1600x' }}
					</div>
				{%- elsif block.settings.video != blank -%}
					{%- liquid
						assign video = block.settings.video
						assign src_type = 'data-src'
						if forloop.index == 1
							assign src_type = 'src'
						endif
					-%}
					<div class="slideshow__slide-video-bg" data-provider="{{ video.type }}" data-video-id="{{ video.id }}">
						{%- if video.type == 'youtube' -%}
							<iframe {{ src_type }}="https://www.youtube.com/embed/{{ video.id }}?loop=1&autoplay=1&mute=1&playlist={{ video.id }}&iv_load_policy=3&disablekb=1&controls=0&playsinline=1&enablejsapi=1" frameborder="0" class="lazyload" allow="autoplay; encrypted-media" allowfullscreen tabindex="-1"></iframe>
						{%- else -%}
							<iframe {{ src_type }}="https://player.vimeo.com/video/{{ video.id }}?background=1" frameborder="0" class="lazyload" allow="autoplay; encrypted-media" allowfullscreen tabindex="-1"></iframe>
						{%- endif -%}
					</div>
				{%- endif -%}
			{%- endif -%}
			<div class="slideshow__slide-overlay" style="background: {{ block.settings.overlay_gradient }}"></div>
			<div class="slideshow__slide-inner content-{{ content_position }}">
				<div class="slideshow__slide-content">
					{% if block.settings.subheading != blank %}
						<p class="subheading{{ subheading_classes }}"{% if subheading_style != blank %} style="{{ subheading_style | strip_newlines | strip }}"{% endif %}>{{ block.settings.subheading }}</p>
					{% endif %}
					{% if block.settings.heading != blank %}
						<div class="split-text slideshow__slide-heading {{ block.settings.heading_size }}{{ heading_font_classes }}"{% if heading_font_style != blank %} style="{{ heading_font_style | strip_newlines | strip }}"{% endif %}>{{ block.settings.heading | replace_first: '|', '<span class="body-font">' | replace: '|', '</span>' }}</div>
					{% endif %}
					{% if block.settings.content != blank %}
					<p class="split-text description-size--{{ block.settings.description_size }}{{ description_font_classes }}"{% if description_font_style != blank %} style="{{ description_font_style | strip_newlines | strip }}"{% endif %}>{{ block.settings.content | newline_to_br }}</p>
					{% endif %}
					{% if block.settings.button_1_text != blank %}
						{% if block.settings.use_text_button_1 %}
						<a class="text-button {{ block.settings.button_1_color }}" href="{{ block.settings.button_1_link }}">{{ block.settings.button_1_text }}</a>
						{% else %}
						<a class="button {{ block.settings.button_1_color }}" href="{{ block.settings.button_1_link }}" role="button" title="{{ block.settings.button_1_text | escape }}"><span data-content="{{ block.settings.button_1_text }}"></span></a>
						{% endif %}
					{% endif %}
					{% if block.settings.button_2_text != blank %}
						{% if block.settings.use_text_button_2 %}
						<a class="text-button {{ block.settings.button_2_color }}" href="{{ block.settings.button_2_link }}">{{ block.settings.button_2_text }}</a>
						{% else %}
						<a class="button {{ block.settings.button_2_color }}" href="{{ block.settings.button_2_link }}" role="button" title="{{ block.settings.button_2_text | escape }}"><span data-content="{{ block.settings.button_2_text }}"></span></a>
						{% endif %}
					{% endif %}
					{% if block.settings.slide_link != blank %}
					<a href="{{ block.settings.slide_link }}" class="slideshow__slide-content-link" tabindex="-1"></a>
					{% endif %}
				</div>
			</div>
		</div>
	{%- endfor -%}
	{%- if section.blocks.size > 1 and dots and dot_style == 'titles' -%}
		<ol class="flickity-custom-dots flickity-dots">
			{%- for block in section.blocks -%}
			<li class="dot" aria-label="{{ forloop.index }}">
				{{ block.settings.slide_title | default: 'Slide' }}
				<span class="dot--progress"><span></span></span>
			</li>
			{%- endfor -%}
		</ol>
	{%- endif -%}
</slide-show>
{% schema %}
  {
    "name": "Slideshow",
		"class": "section-slideshow",
    "settings": [
			{
				"type": "select",
				"id": "desktop_height",
				"label": "Desktop height",
				"options": [
					{
						"value": "desktop-height-image",
						"label": "Adapt to image"
					},
					{
						"value": "desktop-height-auto",
						"label": "Adapt to content"
					},
					{
						"value": "desktop-height-450",
						"label": "450px"
					},
					{
						"value": "desktop-height-550",
						"label": "550px"
					},
					{
						"value": "desktop-height-650",
						"label": "650px"
					},
					{
						"value": "desktop-height-750",
						"label": "750px"
					},
					{
						"value": "desktop-height-full",
						"label": "Full screen"
					},
					{
						"value": "desktop-height-custom",
						"label": "Custom height…"
					}
				],
				"default": "desktop-height-650"
			},
			{
				"type": "range",
				"id": "desktop_height_custom",
				"min": 300,
				"max": 1000,
				"step": 10,
				"unit": "px",
				"label": "Custom desktop height",
				"info": "Used when \"Desktop height\" above is set to Custom height.",
				"default": 650,
				"visible_if": "{{ section.settings.desktop_height == 'desktop-height-custom' }}"
			},
			{
				"type": "select",
				"id": "mobile_height",
				"label": "Mobile height",
				"options": [
					{
						"value": "mobile-height-image",
						"label": "Adapt to image"
					},
					{
						"value": "mobile-height-auto",
						"label": "Adapt to content"
					},
					{
						"value": "mobile-height-400",
						"label": "400px"
					},
					{
						"value": "mobile-height-450",
						"label": "450px"
					},
					{
						"value": "mobile-height-500",
						"label": "500px"
					},
					{
						"value": "mobile-height-full",
						"label": "Full screen"
					},
					{
						"value": "mobile-height-custom",
						"label": "Custom height…"
					}
				],
				"default": "mobile-height-500"
			},
			{
				"type": "range",
				"id": "mobile_height_custom",
				"min": 300,
				"max": 900,
				"step": 10,
				"unit": "px",
				"label": "Custom mobile height",
				"info": "Used when \"Mobile height\" above is set to Custom height.",
				"default": 500,
				"visible_if": "{{ section.settings.mobile_height == 'mobile-height-custom' }}"
			},
			{
        "type": "checkbox",
        "id": "change_header",
        "label": "Change header colors",
        "default": true,
				"info": "If your header is set to transparent and slideshow is the first section, slide text color setting can change the colors inside the header."
      },
			{
        "type": "checkbox",
        "id": "autoplay",
        "label": "Auto-rotate slides",
        "default": true
      },
			{
				"type": "range",
				"id": "autoplay_length",
				"min": 3,
				"max": 10,
				"step": 1,
				"unit": "s",
				"label": "Change slides every",
				"default": 5
			},
			{
				"type": "select",
				"id": "transition",
				"label": "Transition",
				"options": [
					{
						"value": "swipe",
						"label": "Swipe"
					},
					{
						"value": "fade",
						"label": "Fade"
					},
					{
						"value": "slide",
						"label": "Slide"
					}
				],
				"default": "swipe"
			},
			{
	      "type": "header",
	      "content": "Pagination"
	    },
			{
				"type": "select",
				"id": "dot_style",
				"label": "Dot style",
				"options": [
					{
						"value": "titles",
						"label": "Slide titles"
					},
					{
						"value": "regular",
						"label": "Regular dots"
					}
				],
				"default": "titles"
			},
			{
				"type": "select",
				"id": "dot_alignment",
				"label": "Dot alignment",
				"options": [
					{
						"value": "left",
						"label": "Left"
					},
					{
						"value": "center",
						"label": "Center"
					},
					{
						"value": "right",
						"label": "Right"
					}
				],
				"default": "center"
			},
			{
	      "type": "header",
	      "content": "Spacing"
	    },
			{
				"type": "checkbox",
				"id": "disable_top_spacing",
				"default": false,
				"label": "Remove top spacing"
			},
			{
				"type": "checkbox",
				"id": "disable_bottom_spacing",
				"default": false,
				"label": "Remove bottom spacing"
			}
    ],
    "blocks": [
      {
        "type": "slide",
        "name": "Slide",
        "settings": [
					{
						"type": "image_picker",
						"id": "image",
						"label": "Image",
						"info": "2800 x 1000 .jpg recommended for full screen layouts."
					},
					{
						"type": "image_picker",
						"id": "mobile_image",
						"label": "Mobile image (optional)",
						"info": "750 x 1340 .jpg recommended for full screen layouts."
					},
					{
            "id": "slide_link",
            "type": "url",
            "label": "Slide link",
						"info": "Adds a link to slide image"
          },
					{
			      "type": "header",
			      "content": "Video"
			    },
					{
		        "type": "checkbox",
		        "id": "video_background",
		        "label": "Use video as a background",
		        "default": false
		      },
					{
						"type": "video_url",
		        "id": "video",
		        "label": "Video URL",
						"accept": [
		          "youtube",
		          "vimeo"
		        ],
						"placeholder": "Use a YouTube or Vimeo URL",
						"default": "https:\/\/www.youtube.com\/watch?v=_9VUPq3SxOc"
		      },
					{
					  "type": "video",
					  "id": "video_hosted",
					  "label": "Shopify-hosted video",
						"info": "Overrides the Video URL setting."
					},
					{
			      "type": "header",
			      "content": "Content"
			    },
					{
						"type": "text",
						"id": "slide_title",
						"label": "Slide dot title",
						"default": "Slide",
						"info": "This text will be used inside slideshow dots."
					},
					{
						"type": "text",
						"id": "subheading",
						"label": "Subheading",
						"default": "Add a tagline"
					},
					{
						"type": "range",
						"id": "subheading_font_size_desktop",
						"min": 0,
						"max": 40,
						"step": 1,
						"unit": "px",
						"label": "Subheading font size (desktop)",
						"info": "0 uses the theme default size.",
						"default": 0
					},
					{
						"type": "range",
						"id": "subheading_font_size_mobile",
						"min": 0,
						"max": 40,
						"step": 1,
						"unit": "px",
						"label": "Subheading font size (mobile)",
						"info": "0 uses the theme default size.",
						"default": 0
					},
          {
            "type": "textarea",
            "id": "heading",
            "label": "Heading",
            "default": "Slide |Heading|",
						"info": "Wrap your text between | to use body font. For example: Heading |continued|"
          },
					{
						"type": "select",
						"id": "heading_size",
						"label": "Heading size",
						"options": [
							{
								"value": "h2",
								"label": "Small"
							},
							{
								"value": "h1",
								"label": "Medium"
							},
							{
								"value": "h1-large",
								"label": "Large"
							},
							{
								"value": "h1-xlarge",
								"label": "Extra large"
							}
						],
						"default": "h1-xlarge"
					},
					{
						"type": "range",
						"id": "heading_font_size_desktop",
						"min": 0,
						"max": 120,
						"step": 1,
						"unit": "px",
						"label": "Heading font size (desktop)",
						"info": "0 uses the \"Heading size\" preset above.",
						"default": 0
					},
					{
						"type": "range",
						"id": "heading_font_size_mobile",
						"min": 0,
						"max": 80,
						"step": 1,
						"unit": "px",
						"label": "Heading font size (mobile)",
						"info": "0 uses the \"Heading size\" preset above.",
						"default": 0
					},
          {
            "type": "textarea",
            "id": "content",
            "label": "Description",
            "default": "Add descriptive text for your slide here."
          },
					{
						"type": "select",
						"id": "description_size",
						"label": "Description size",
						"options": [
							{
								"value": "small",
								"label": "Small"
							},
							{
								"value": "medium",
								"label": "Medium"
							},
							{
								"value": "large",
								"label": "Large"
							}
						],
						"default": "medium"
					},
					{
						"type": "range",
						"id": "description_font_size_desktop",
						"min": 0,
						"max": 40,
						"step": 1,
						"unit": "px",
						"label": "Description font size (desktop)",
						"info": "0 uses the \"Description size\" preset above.",
						"default": 0
					},
					{
						"type": "range",
						"id": "description_font_size_mobile",
						"min": 0,
						"max": 40,
						"step": 1,
						"unit": "px",
						"label": "Description font size (mobile)",
						"info": "0 uses the \"Description size\" preset above.",
						"default": 0
					},
					{
						 "type": "select",
						 "id": "content_position",
						 "label": "Content position",
						 "options": [
							 { "value": "middle-left", "label": "Middle left" },

{{- 'scrolling-text.css' | asset_url | stylesheet_tag -}}
{%- liquid
	assign bg_image = section.settings.bg_image
	assign height = section.settings.height
	assign text_position = section.settings.text_position
	assign speed = section.settings.speed
	assign rotation = section.settings.rotation
	assign negative_rotation = section.settings.negative_rotation
	assign image_size = section.settings.image_size
	assign text_size = section.settings.text_size
	assign text_uppercase = section.settings.text_uppercase
	assign direction = section.settings.direction

	assign color_bg = section.settings.color_bg
	assign overlay_color = section.settings.overlay_color
	assign overlay_opacity = section.settings.overlay_opacity

	assign disable_top_spacing = section.settings.disable_top_spacing
	assign disable_bottom_spacing = section.settings.disable_bottom_spacing
	assign size = section.blocks.size | plus: 0
	case image_size
		when 'small'
			assign image_width = '0x100'
		when 'medium'
			assign image_width = '0x200'
		when 'large'
			assign image_width = '0x400'
	endcase

	if negative_rotation
		assign negative = '-'
	endif
-%}
<div class="scrolling-text scrolling-text-uppercase--{{ text_uppercase }} scrolling-text--content-{{ text_position }} section-spacing{% if disable_top_spacing %} section-spacing--disable-top{% endif %}{% if disable_bottom_spacing %} section-spacing--disable-bottom{% endif %} {{ height }}" style="--color-bg:{{ color_bg }}; --overlay-color-rgb: {{ overlay_color.rgb | replace: ' ' , ',' }}; --overlay-opacity: {{ overlay_opacity | divided_by: 100.0 }}; --rotation: {{ negative }}{{ rotation | append: 'deg' }}; {% if bg_image %}--bg-image: url({{ bg_image | image_url: width: bg_image.src.width }});{% endif %}">
	<div class="scrolling-text--inner direction-{{ direction }}" style="--marquee-speed: {{ speed }}; --font-size: {{ text_size | append: 'px' }}">
		{% capture scrolling_text %}
		<div>
			{%- for block in section.blocks -%}
				{%- liquid
					assign color_text = block.settings.color_text
					assign color_text_gradient = block.settings.color_text_gradient
				-%}
				<div class="scrolling-text--item{% if color_text_gradient != '' %} gradient-text{% endif %} outline-text--{{ block.settings.outline_text }}" style=" --color-text:{{ color_text }}; --color-text-gradient: {{ color_text_gradient }};" {{ block.shopify_attributes }}>
					{%- if block.settings.link -%}
						<a href="{{ block.settings.link }}" target="_blank" class="scrolling-text--link">
					{%- endif -%}
					{%- if block.settings.image -%}
					{%- liquid
						assign class = 'scrolling-text--image scrolling-text--image--' | append: image_size
						render 'responsive-image', image: block.settings.image, sizes: image_width, class: class -%}
					{%- endif -%}
					<span>{{ block.settings.text }}</span>
					{%- if block.settings.link -%}
						</a>
					{%- endif -%}
				</div>
			{%- endfor -%}
		</div>
		{%- endcapture -%}
		{{- scrolling_text }}{{ scrolling_text }}{{ scrolling_text -}}
	</div>
</div>
{% schema %}
  {
    "name": "Scrolling text",
		"class": "section-scrolling-text",
    "settings": [
			{
				"type": "image_picker",
				"id": "bg_image",
				"label": "Background image"
			},
			{
				"type": "select",
				"id": "height",
				"label": "Height",
				"options": [
					{
						"value": "height-auto",
						"label": "Adapt to content"
					},
					{
						"value": "height-300",
						"label": "300px"
					},
					{
						"value": "height-350",
						"label": "350px"
					},
					{
						"value": "height-400",
						"label": "400px"
					},
					{
						"value": "height-450",
						"label": "450px"
					},
					{
						"value": "height-550",
						"label": "550px"
					},
					{
						"value": "height-650",
						"label": "650px"
					},
					{
						"value": "height-full",
						"label": "Full screen"
					}
				],
				"default": "height-300"
			},
			{
				"type": "select",
				"id": "text_position",
				"label": "Text position",
				"options": [
					{ "value": "top", "label": "Top" },
					{ "value": "middle", "label": "Middle" },
					{ "value": "bottom", "label": "Bottom" }
				],
				"default": "middle"
			},
			{
				"type": "select",
				"id": "direction",
				"options": [
					{
						"value": "left",
						"label": "Left"
					},
					{
						"value": "right",
						"label": "Right"
					}
				],
				"default": "left",
				"label": "Direction"
			},
			{
				"type": "select",
				"id": "speed",
				"options": [
					{
						"value": "10s",
						"label": "Fast"
					},
					{
						"value": "20s",
						"label": "Normal"
					},
					{
						"value": "30s",
						"label": "Slow"
					},
					{
						"value": "50s",
						"label": "Very slow"
					}
				],
				"default": "20s",
				"label": "Speed"
			},
			{
        "type": "range",
        "id": "rotation",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "°",
        "label": "Rotation",
        "default": 0
      },
			{
        "type": "checkbox",
        "id": "negative_rotation",
        "label": "Enable negative rotation",
        "default": false
      },
			{
        "type": "range",
        "id": "text_size",
        "min": 16,
        "max": 140,
        "step": 2,
        "unit": "px",
        "label": "Text size",
        "default": 56
      },
			{
				"type": "checkbox",
				"id": "text_uppercase",
				"default": false,
				"label": "Make text uppercase"
			},
			{
				"type": "select",
				"id": "image_size",
				"options": [
					{
						"value": "small",
						"label": "Small"
					},
					{
						"value": "medium",
						"label": "Medium"
					},
					{
						"value": "large",
						"label": "Large"
					}
				],
				"default": "large",
				"label": "Image size"
			},
			{
	      "type": "header",
	      "content": "Colors"
	    },
			{
        "type": "color",
        "id": "color_bg",
        "label": "Background",
        "default": "transparent"
      },
			{
				"type": "color",
				"id": "overlay_color",
				"label": "Overlay",
				"default": "#000000"
			},
			{
				"type": "range",
				"id": "overlay_opacity",
				"min": 0,
				"max": 100,
				"step": 1,
				"unit": "%",
				"label": "Overlay opacity",
				"default": 0
			},
			{
	      "type": "header",
	      "content": "Spacing"
	    },
			{
				"type": "checkbox",
				"id": "disable_top_spacing",
				"default": false,
				"label": "Remove top spacing"
			},
			{
				"type": "checkbox",
				"id": "disable_bottom_spacing",
				"default": false,
				"label": "Remove bottom spacing"
			}
    ],
		"blocks": [
      {
        "type": "text",
        "name": "Text",
        "settings": [
					{
						"type": "image_picker",
						"id": "image",
						"label": "Image"
					},
          {
            "type": "text",
            "id": "text",
            "label": "Content",
						"default": "Add campaign text here."
          },
					{
						"id": "link",
						"type": "url",
						"label": "Link"
					},
					{
		        "type": "checkbox",
		        "id": "outline_text",
		        "label": "Make text outline",
		        "default": false
		      },
					{
						"type": "header",
						"content": "Colors"
					},
					{
						"type": "color",
						"id": "color_text",
						"label": "Text",
						"default": "#232323"
					},
					{
						"type": "color_background",
						"id": "color_text_gradient",
						"label": "Text gradient",
						"default": "linear-gradient(180deg, rgba(224,224,224, 1), rgba(224, 224, 224, 0) 100%)",
						"info": "Gradient colors do not work with outline text."
					}
				]
			}
		],
    "presets": [
      {
        "name": "Scrolling text",
				"blocks": [
					{
						"type": "text"
					},
					{
						"type": "text"
					},
					{
						"type": "text"
					}
				]
      }
    ]
  }
{% endschema %}

{{- 'instagram-followers.css' | asset_url | stylesheet_tag -}}
{%- liquid
	assign small_heading = section.settings.small_heading
	assign heading = section.settings.heading
	assign description = section.settings.description
	assign button_label = section.settings.button_label
	assign button_link = section.settings.button_link
	assign button_style = section.settings.button_style
	assign button_text_color = section.settings.button_text_color
	assign button_bg_color = section.settings.button_bg_color
	assign button_border_color = section.settings.button_border_color

	assign gap_desktop = section.settings.gap_desktop | default: 6
	assign gap_mobile = section.settings.gap_mobile | default: 6
	assign bg_desktop = section.settings.background_color_desktop
	assign bg_mobile = section.settings.background_color_mobile
	assign margin_top_d = section.settings.margin_top_desktop
	assign margin_bottom_d = section.settings.margin_bottom_desktop
	assign margin_top_m = section.settings.margin_top_mobile
	assign margin_bottom_m = section.settings.margin_bottom_mobile

	assign heading_content = heading | replace_first: '|', '<span class="body-font">' | replace: '|', '</span>'
-%}
{%- capture section_style -%}
	--if-gap-desktop: {{ gap_desktop }}px;
	--if-gap-mobile: {{ gap_mobile }}px;
	{%- if bg_desktop != blank %}--if-bg-desktop: {{ bg_desktop }};{% endif -%}
	{%- if bg_mobile != blank %}--if-bg-mobile: {{ bg_mobile }};{% endif -%}
	{%- if margin_top_d != blank %}--if-margin-top-desktop: {{ margin_top_d }}px;{% endif -%}
	{%- if margin_bottom_d != blank %}--if-margin-bottom-desktop: {{ margin_bottom_d }}px;{% endif -%}
	{%- if margin_top_m != blank %}--if-margin-top-mobile: {{ margin_top_m }}px;{% endif -%}
	{%- if margin_bottom_m != blank %}--if-margin-bottom-mobile: {{ margin_bottom_m }}px;{% endif -%}
	{%- if button_bg_color != blank %}--solid-button-background: {{ button_bg_color }};{% endif -%}
	{%- if button_text_color != blank %}--solid-button-label: {{ button_text_color }};{% endif -%}
	{%- if button_border_color != blank %}--if-button-border-color: {{ button_border_color }};{% endif -%}
{%- endcapture -%}
<div class="instagram-followers" style="{{ section_style | strip_newlines | strip }}">
	<div class="row full-width-row">
		<div class="small-12 columns">

			{%- if section.blocks.size > 0 -%}
			<div class="instagram-followers--grid" style="--if-block-count: {{ section.blocks.size }};">
				{%- for block in section.blocks -%}
					{%- render 'instagram-followers-item', block: block, index0: forloop.index0, total: section.blocks.size -%}
				{%- endfor -%}
			</div>
			{%- endif -%}

			{%- if small_heading != blank or heading != blank or description != blank or button_label != blank -%}
			<div class="instagram-followers--header">
				{%- if small_heading != blank -%}
					{%- render 'instagram-followers-text', tag: 'div', base_class: 'instagram-followers--kicker', content: small_heading, css_prefix: 'if-kicker', font_d: section.settings.small_heading_font, font_m: section.settings.small_heading_font, font_picker_d: section.settings.small_heading_font_picker, font_picker_m: section.settings.small_heading_font_picker, size_d: section.settings.small_heading_size_desktop, size_m: section.settings.small_heading_size_mobile, case_d: section.settings.small_heading_case_desktop, case_m: section.settings.small_heading_case_mobile, color: section.settings.small_heading_color -%}
				{%- endif -%}
				{%- if heading != blank -%}
					{%- render 'instagram-followers-text', tag: 'h2', base_class: 'instagram-followers--heading', content: heading_content, css_prefix: 'if-heading', font_d: section.settings.heading_font, font_m: section.settings.heading_font, font_picker_d: section.settings.heading_font_picker, font_picker_m: section.settings.heading_font_picker, size_d: section.settings.heading_size_desktop, size_m: section.settings.heading_size_mobile, case_d: section.settings.heading_case_desktop, case_m: section.settings.heading_case_mobile, color: section.settings.heading_color -%}
				{%- endif -%}
				{%- if description != blank -%}
					{%- render 'instagram-followers-text', tag: 'div', base_class: 'rte instagram-followers--description', content: description, css_prefix: 'if-description', font_d: section.settings.description_font, font_m: section.settings.description_font, font_picker_d: section.settings.description_font_picker, font_picker_m: section.settings.description_font_picker, size_d: section.settings.description_size_desktop, size_m: section.settings.description_size_mobile, case_d: section.settings.description_case_desktop, case_m: section.settings.description_case_mobile, color: section.settings.description_color -%}
				{%- endif -%}
				{%- if button_label != blank -%}
					<div class="instagram-followers--button-wrap">
						{%- if button_style == 'solid' -%}
							<a class="button"{% if button_link == blank %} role="link" aria-disabled="true"{% else %} href="{{ button_link }}"{% endif %}><span data-content="{{ button_label }}"></span></a>
						{%- else -%}
							<a class="text-button"{% if button_link == blank %} role="link" aria-disabled="true"{% else %} href="{{ button_link }}"{% endif %}{% if button_text_color != blank %} style="color: {{ button_text_color }};"{% endif %}>{{ button_label }}</a>
						{%- endif -%}
					</div>
				{%- endif -%}
			</div>
			{%- endif -%}

		</div>
	</div>
</div>


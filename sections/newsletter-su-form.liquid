{%- liquid
	assign heading = section.settings.heading
	assign text = section.settings.text
	assign custom_liquid = section.settings.custom_liquid

	assign heading_font = section.settings.heading_font
	assign heading_font_picker = section.settings.heading_font_picker
	assign text_font = section.settings.text_font
	assign text_font_picker = section.settings.text_font_picker

	assign text_align_mobile = 'start'
	assign flex_align_mobile = 'flex-start'
	case section.settings.alignment_mobile
		when 'center'
			assign text_align_mobile = 'center'
			assign flex_align_mobile = 'center'
		when 'right'
			assign text_align_mobile = 'end'
			assign flex_align_mobile = 'flex-end'
	endcase

	assign text_align_desktop = 'start'
	assign flex_align_desktop = 'flex-start'
	case section.settings.alignment_desktop
		when 'center'
			assign text_align_desktop = 'center'
			assign flex_align_desktop = 'center'
		when 'right'
			assign text_align_desktop = 'end'
			assign flex_align_desktop = 'flex-end'
	endcase
-%}
{%- capture heading_font_family -%}
	{%- case heading_font -%}
		{%- when 'body' -%}{{ settings.body_font.family }}, {{ settings.body_font.fallback_families }}
		{%- when 'custom' -%}{%- if heading_font_picker -%}{{ heading_font_picker.family }}, {{ heading_font_picker.fallback_families }}{%- endif -%}
		{%- else -%}{{ settings.heading_font.family }}, {{ settings.heading_font.fallback_families }}
	{%- endcase -%}
{%- endcapture -%}
{%- capture text_font_family -%}
	{%- case text_font -%}
		{%- when 'heading' -%}{{ settings.heading_font.family }}, {{ settings.heading_font.fallback_families }}
		{%- when 'custom' -%}{%- if text_font_picker -%}{{ text_font_picker.family }}, {{ text_font_picker.fallback_families }}{%- endif -%}
		{%- else -%}{{ settings.body_font.family }}, {{ settings.body_font.fallback_families }}
	{%- endcase -%}
{%- endcapture -%}
{%- capture custom_font_faces -%}
	{%- if heading_font == 'custom' and heading_font_picker -%}{{ heading_font_picker | font_face: font_display: 'swap' }}{%- endif -%}
	{%- if text_font == 'custom' and text_font_picker -%}{{ text_font_picker | font_face: font_display: 'swap' }}{%- endif -%}
{%- endcapture -%}
<link rel="stylesheet" href="{{ 'newsletter-su-form.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'newsletter-su-form.css' | asset_url | stylesheet_tag }}</noscript>
{%- if custom_font_faces != blank -%}
<style>{{ custom_font_faces }}</style>
{%- endif -%}
<div class="newsletter-su" style="
	--nsu-bg: {{ section.settings.color_background }};
	--nsu-heading-color: {{ section.settings.color_heading }};
	--nsu-text-color: {{ section.settings.color_text }};
	--nsu-margin-top-mobile: {{ section.settings.margin_top_mobile }}px;
	--nsu-margin-bottom-mobile: {{ section.settings.margin_bottom_mobile }}px;
	--nsu-margin-top-desktop: {{ section.settings.margin_top_desktop }}px;
	--nsu-margin-bottom-desktop: {{ section.settings.margin_bottom_desktop }}px;
	--nsu-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
	--nsu-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
	--nsu-padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
	--nsu-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
	--nsu-align-mobile: {{ text_align_mobile }};
	--nsu-align-desktop: {{ text_align_desktop }};
	--nsu-flex-align-mobile: {{ flex_align_mobile }};
	--nsu-flex-align-desktop: {{ flex_align_desktop }};
	--nsu-content-width-mobile: {{ section.settings.content_width_mobile }}px;
	--nsu-content-width-desktop: {{ section.settings.content_width_desktop }}px;
	--nsu-heading-font: {{ heading_font_family | strip }};
	--nsu-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
	--nsu-heading-size-desktop: {{ section.settings.heading_size_desktop }}px;
	--nsu-heading-spacing: {{ section.settings.heading_spacing }}px;
	--nsu-text-font: {{ text_font_family | strip }};
	--nsu-text-size-mobile: {{ section.settings.text_size_mobile }}px;
	--nsu-text-size-desktop: {{ section.settings.text_size_desktop }}px;
	--nsu-text-width-mobile: {{ section.settings.text_width_mobile }}px;
	--nsu-text-width-desktop: {{ section.settings.text_width_desktop }}px;
	--nsu-text-spacing: {{ section.settings.text_spacing }}px;
">
	<div class="row full-width-row">
		<div class="small-12 columns newsletter-su__columns">
			<div class="newsletter-su__inner">
				{%- if heading != blank -%}
					<h2 class="newsletter-su__heading">{{ heading }}</h2>
				{%- endif -%}
				{%- if text != blank -%}
					<div class="rte newsletter-su__text">{{ text }}</div>
				{%- endif -%}
				{%- if custom_liquid != blank -%}
					<div class="newsletter-su__form">{{ custom_liquid }}</div>
				{%- endif -%}
			</div>
		</div>
	</div>
</div>

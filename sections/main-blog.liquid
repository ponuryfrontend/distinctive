{{ 'blog.css' | asset_url | stylesheet_tag }}
{% liquid
	assign show_date = section.settings.show_date
	assign show_excerpt = section.settings.show_excerpt
	assign show_hover_letters = section.settings.show_hover_letters
	assign image_ratio = section.settings.image_ratio
%}
{%- paginate blog.articles by 8 -%}
<div class="section-spacing-bottom">
	<div class="row full-width-row">
		{%- for article in blog.articles -%}
			{%- liquid
				assign large_class = ''
				assign large = false
				if forloop.index == 4 or forloop.index == 5
					assign large_class = 'large-6'
					assign large = true
				endif
			-%}
			<div class="small-12 medium-4 {{ large_class }} columns">
				{% render 'blog-post', article: article, show_date: show_date, show_excerpt: show_excerpt, image_ratio: image_ratio, is_large: large, show_hover_letters: show_hover_letters %}
			</div>
		{%- endfor -%}
	</div>
	{% render 'pagination', paginate: paginate, pagination_type: 'paginated', locale: 'blog' %}
</div>
{%- endpaginate -%}

{% schema %}
  {
		"name": "Blog posts",
	  "class": "blog-section",
    "settings": [
			{
        "type": "select",
        "id": "image_ratio",
        "options": [
          {
            "value": "adapt",
            "label": "Adapt to image"
          },
          {
            "value": "portrait",
            "label": "Portrait"
          },
          {
            "value": "square",
            "label": "Square"
          },
					{
            "value": "landscape",
            "label": "Landscape"
          }
        ],
        "default": "landscape",
        "label": "Image ratio"
      },
			{
				"type": "checkbox",
				"id": "show_date",
				"default": true,
				"label": "Show date"
			},
			{
				"type": "checkbox",
				"id": "show_excerpt",
				"default": true,
				"label": "Show excerpt"
			},
			{
				"type": "checkbox",
				"id": "show_hover_letters",
				"default": true,
				"label": "Show first letter on hover"
			},
	    {
	      "type": "paragraph",
	      "content": "Change excerpts by editing your blog posts. [Learn more](https://help.shopify.com/en/manual/online-store/blogs/writing-blogs#display-an-excerpt-from-a-blog-post)"
	    }
    ]
  }
{% endschema %}

{{- 'product.css' | asset_url | stylesheet_tag -}}
{%- liquid
	assign first_3d_model = product.media | where: "media_type", "model" | first
	assign media_aspect_ratio = section.settings.media_aspect_ratio

	assign image_index = -1

	assign display_captions = section.settings.display_captions
	assign hide_variants = section.settings.hide_variants
	assign featured_media = product.selected_or_first_available_variant.featured_media

	assign first_image = nil
	assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src'

-%}
{%- if first_3d_model -%}
  <link id="ModelViewerStyle" rel="stylesheet" href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css" media="print" onload="this.media='all'">
  <link id="ModelViewerOverride" rel="stylesheet" href="{{ 'product-model-viewer-ui.css' | asset_url }}" media="print" onload="this.media='all'">
{%- endif -%}

<div class="thb-product-detail product main-product-page" data-handle="{{ product.handle }}">
  <div class="row full-width-row-full">
		<div class="small-12 columns">
			<div class="product-grid-container">
		    <div class="product-gallery-container" id="MediaGallery-{{ section.id }}">
          <div class="product-image-container">
            <product-slider id="Product-Slider" class="product-images static-dots" data-captions="{{ display_captions }}" data-hide-variants="{{ hide_variants }}">
              {%- if featured_media != null -%}
                {%- liquid
                  assign image_index = image_index | plus: 1
                  assign first_image = featured_media.preview_image
                -%}
                {%- render 'product-media', product: product, section: section, forloop: false, media: featured_media, sizes: sizes, variant_images: variant_images, media_aspect_ratio: media_aspect_ratio, hide_variants: hide_variants, display_captions: display_captions, priority: 'high' -%}
              {%- endif -%}
              {%- for media in product.media -%}
                {%- unless media.id == featured_media.id -%}
                  {%- liquid
                    if media.media_type == 'image'
                      assign image_index = image_index | default: 0 | plus: 1
                    endif
                    assign priority = false
                    if image_index == 0
                      assign first_image = media.preview_image
                      assign priority = 'high'
                    endif
                  -%}
                  {%- render 'product-media', product: product, section: section, forloop: forloop, media: media, sizes: sizes, variant_images: variant_images, media_aspect_ratio: media_aspect_ratio, hide_variants: hide_variants, display_captions: display_captions, priority: priority -%}
                {%- endunless -%}
              {%- endfor -%}
              {%- if product.media.size > 1 -%}
              {%- render 'slideshow-arrows' -%}
              {%- endif -%}
            </product-slider>
            {%- if product.media.size > 1 -%}
              {%- liquid
                assign thumbnail_count = product.media.size | at_most: 4
                assign width = thumbnail_count | times: 63 | plus: 19
              -%}
            <div id="Product-Thumbnails" class="product-thumbnail-container" data-hide-variants="{{ hide_variants }}" style="--thumbnail-width: {{ width | append: 'px'}}">
              <button class="product-thumbnail-container--button" aria-label="Toggle"></button>
              <scroll-shadow>
                <div class="product-thumbnail-container--inner">
                  {%- if featured_media != null -%}
                    {%- render 'product-thumbnail', product: product, media: featured_media, forloop: false, variant_images: variant_images, media_aspect_ratio: media_aspect_ratio, hide_variants: hide_variants -%}
                  {%- endif -%}
                  {%- for media in product.media -%}
                    {%- unless media.id == featured_media.id -%}
                    {%- render 'product-thumbnail', product: product, media: media, forloop: forloop, variant_images: variant_images, media_aspect_ratio: media_aspect_ratio, hide_variants: hide_variants -%}
                    {%- endunless -%}
                  {%- endfor -%}
                </div>
              </scroll-shadow>
            </div>
            {%- endif -%}
          </div>
        </div>
        <scroll-shadow class="product-information--container">
          <div class="product-information">
            {% render 'product-information', product: product, section: section, update_url: true, pickup: true, first_image: first_image, hide_variants: hide_variants %}
          </div>
        </scroll-shadow>
			</div>
		</div>
  </div>
</div>
<div class="side-panel side-availability" id="Pickup-Availability" tabindex="-1"></div>
{%- assign side_panels = section.blocks | where: "type", "side_panel" -%}
{%- for block in side_panels -%}
<div class="side-panel product-information-drawer" id="side-panel-{{ section.id }}-information-panel-{{ forloop.index }}" tabindex="-1">
	<div class="side-panel-inner">
		<div class="side-panel-header">
			<div>
				<span class="h5 body-font">{{ block.settings.side_panel_label }}</span>
				<side-panel-close class="side-panel-close" tabindex="0">{%- render 'svg-icons' with 'close' -%}</side-panel-close>
			</div>
		</div>
		<div class="side-panel-content">
      <div class="rte">
        {{ block.settings.side_panel_content }}
        {{ block.settings.side_panel_page.content }}
      </div>
		</div>
	</div>
</div>
{%- endfor -%}

{%- if section.settings.lightbox != blank -%}
{% render 'photoswipe' %}
<link rel="stylesheet" href="{{ 'photoswipe.css' | asset_url }}" media="print" onload="this.media='all'">
{%- endif -%}
<script src="{{ 'product.js' | asset_url }}" defer="defer"></script>

{%- if first_3d_model -%}
  <script type="application/json" id="ProductJSON-{{ product.id }}">
    {{ product.media | where: 'media_type', 'model' | json }}
  </script>

  <script src="{{ 'product-model.js' | asset_url }}" defer></script>
{%- endif -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_url = shop.url | append: product.url
  assign product_desc = product.description | strip_html | strip_newlines | truncate: 5000

  assign review_data = product.metafields.ssw['review']
  if review_data and review_data.type == 'json'
    assign review_data = review_data.value
  endif

  assign review_count = 0
  assign review_avg = 0

  if review_data
    assign review_count = review_data.count | plus: 0
    assign review_avg = review_data.avg | plus: 0
  endif

  assign promo_valid_until = blank
  if product.metafields.custom.price_valid_until != blank
    assign promo_valid_until = product.metafields.custom.price_valid_until.value | default: product.metafields.custom.price_valid_until
  endif

  assign schema_country = localization.country.iso_code | default: 'PL'
  assign schema_currency = cart.currency.iso_code
  assign return_policy_id = shop.url | append: '#return-policy-' | append: schema_country | downcase

  assign breadcrumb_collection = blank
  if collection and collection.url
    assign breadcrumb_collection = collection
  elsif product.collections.size > 0
    assign breadcrumb_collection = product.collections.first
  endif
-%}
<script src="{{ 'color-swatches.js' | asset_url }}" defer></script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "@id": {{ product_url | append: '#breadcrumb' | json }},
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Strona główna",
          "item": {{ shop.url | append: routes.root_url | json }}
        }{% if breadcrumb_collection != blank %},
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ breadcrumb_collection.title | strip | json }},
          "item": {{ shop.url | append: breadcrumb_collection.url | json }}
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": {{ product.title | strip | json }},
          "item": {{ product_url | json }}
        }{% else %},
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ product.title | strip | json }},
          "item": {{ product_url | json }}
        }{% endif %}
      ]
    },
    {%- if product.variants.size > 1 -%}
    {
      "@type": "ProductGroup",
      "@id": {{ product_url | append: '#productgroup' | json }},
      "productGroupID": {{ product.id | json }},
      "name": {{ product.title | strip | json }},
      "description": {{ product_desc | json }},
      "url": {{ product_url | json }},
      "brand": {
        "@type": "Brand",
        "name": {{ product.vendor | default: shop.name | json }}
      }{% if product.featured_image %},
      "image": [
        {{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }}
      ]{% endif %}{% if product.type != blank %},
      "category": {{ product.type | json }}{% endif %}{% if current_variant.sku != blank %},
      "sku": {{ current_variant.sku | strip | json }}{% endif %}{% if review_count > 0 and review_avg > 0 %},
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": {{ review_avg | json }},
        "reviewCount": {{ review_count | json }}
      }{% endif %},
      "hasVariant": [
        {%- for variant in product.variants -%}
          {%- liquid
            assign variant_url = shop.url | append: product.url | append: '?variant=' | append: variant.id
            assign variant_image = variant.featured_media.preview_image | default: product.featured_image
            assign variant_on_sale = false

            if variant.compare_at_price > variant.price
              assign variant_on_sale = true
            endif
          -%}
          {
            "@type": "Product",
            "@id": {{ variant_url | append: '#product' | json }},
            "isVariantOf": {
              "@id": {{ product_url | append: '#productgroup' | json }}
            },
            "name": {{ product.title | append: ' - ' | append: variant.title | strip | json }},
            "url": {{ variant_url | json }},
            "description": {{ product_desc | json }},
            "image": [
              {{ variant_image | image_url: width: 1200 | prepend: 'https:' | json }}
            ],
            "brand": {
              "@type": "Brand",
              "name": {{ product.vendor | default: shop.name | json }}
            }{% if variant.sku != blank %},
            "sku": {{ variant.sku | strip | json }}{% endif %}{% if variant.barcode != blank %}
              {%- assign barcode_length = variant.barcode | size -%}
              {%- if barcode_length == 8 -%},
                "gtin8": {{ variant.barcode | json }}
              {%- elsif barcode_length == 12 -%},
                "gtin12": {{ variant.barcode | json }}
              {%- elsif barcode_length == 13 -%},
                "gtin13": {{ variant.barcode | json }}
              {%- elsif barcode_length == 14 -%},
                "gtin14": {{ variant.barcode | json }}
              {%- else -%},
                "gtin": {{ variant.barcode | json }}
              {%- endif -%}
            {%- endif %}{% if review_count > 0 and review_avg > 0 %},
            "aggregateRating": {
              "@type": "AggregateRating",
              "ratingValue": {{ review_avg | json }},
              "reviewCount": {{ review_count | json }}
            }{% endif %},
            "offers": {
              "@type": "Offer",
              "url": {{ variant_url | json }},
              "priceCurrency": {{ schema_currency | json }},
              "price": {{ variant.price | divided_by: 100.0 | json }}{% if variant_on_sale and promo_valid_until != blank %},
              "priceValidUntil": {{ promo_valid_until | date: "%Y-%m-%d" | json }}{% endif %},
              "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
              "itemCondition": "https://schema.org/NewCondition"{% if variant.requires_shipping or return_policy_id != blank %},{% endif %}
              {% if variant.requires_shipping %}
              "shippingDetails": [
                {% if schema_country == 'PL' %}
                {
                  "@type": "OfferShippingDetails",
                  "shippingRate": {
                    "@type": "MonetaryAmount",
                    "value": 14,
                    "currency": "PLN"
                  },
                  "shippingDestination": {
                    "@type": "DefinedRegion",
                    "addressCountry": "PL"
                  },
                  "deliveryTime": {
                    "@type": "ShippingDeliveryTime",
                    "handlingTime": {
                      "@type": "QuantitativeValue",
                      "minValue": 1,
                      "maxValue": 2,
                      "unitCode": "DAY"
                    },
                    "transitTime": {
                      "@type": "QuantitativeValue",
                      "minValue": 1,
                      "maxValue": 2,
                      "unitCode": "DAY"
                    }
                  },
                  "shippingLabel": "Paczkomat InPost"
                },
                {
                  "@type": "OfferShippingDetails",
                  "shippingRate": {
                    "@type": "MonetaryAmount",
                    "value": 16,
                    "currency": "PLN"
                  },
                  "shippingDestination": {
                    "@type": "DefinedRegion",
                    "addressCountry": "PL"
                  },
                  "deliveryTime": {
                    "@type": "ShippingDeliveryTime",
                    "handlingTime": {
                      "@type": "QuantitativeValue",
                      "minValue": 1,
                      "maxValue": 2,
                      "unitCode": "DAY"
                    },
                    "transitTime": {
                      "@type": "QuantitativeValue",
                      "minValue": 1,
                      "maxValue": 2,
                      "unitCode": "DAY"
                    }
                  },
                  "shippingLabel": "Kurier InPost"
                },
                {
                  "@type": "OfferShippingDetails",
                  "shippingRate": {
                    "@type": "MonetaryAmount",
                    "value": 24,
                    "currency": "PLN"
                  },
                  "shippingDestination": {
                    "@type": "DefinedRegion",
                    "addressCountry": "PL"
                  },
                  "deliveryTime": {
                    "@type": "ShippingDeliveryTime",
                    "handlingTime": {
                      "@type": "QuantitativeValue",
                      "minValue": 1,
                      "maxValue": 2,
                      "unitCode": "DAY"
                    },
                    "transitTime": {
                      "@type": "QuantitativeValue",
                      "minValue": 1,
                      "maxValue": 2,
                      "unitCode": "DAY"
                    }
                  },
                  "shippingLabel": "Kurier InPost Pobranie"
                }
                {% else %}
                {
                  "@type": "OfferShippingDetails",
                  "shippingRate": {
                    "@type": "MonetaryAmount",
                    "value": 9.90,
                    "currency": "EUR"
                  },
                  "shippingDestination": {
                    "@type": "DefinedRegion",
                    "addressCountry": {{ schema_country | json }}
                  },
                  "deliveryTime": {
                    "@type": "ShippingDeliveryTime",
                    "handlingTime": {
                      "@type": "QuantitativeValue",
                      "minValue": 1,
                      "maxValue": 2,
                      "unitCode": "DAY"
                    },
                    "transitTime": {
                      "@type": "QuantitativeValue",
                      "minValue": 1,
                      "maxValue": 4,
                      "unitCode": "DAY"
                    }
                  },
                  "shippingLabel": "DHL"
                }
                {% endif %}
              ]{% if return_policy_id != blank %},{% endif %}
              {% endif %}
              {% if return_policy_id != blank %}
              "hasMerchantReturnPolicy": {
                "@id": {{ return_policy_id | json }}
              }
              {% endif %}
            }
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
    {%- else -%}
    {
      "@type": "Product",
      "@id": {{ product_url | append: '#product' | json }},
      "name": {{ product.title | strip | json }},
      "url": {{ product_url | json }},
      "description": {{ product_desc | json }},
      "brand": {
        "@type": "Brand",
        "name": {{ product.vendor | default: shop.name | json }}
      }{% if product.featured_image %},
      "image": [
        {{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }}
      ]{% endif %}{% if product.type != blank %},
      "category": {{ product.type | json }}{% endif %}{% if current_variant.sku != blank %},
      "sku": {{ current_variant.sku | strip | json }}{% endif %}{% if current_variant.barcode != blank %}
        {%- assign barcode_length = current_variant.barcode | size -%}
        {%- if barcode_length == 8 -%},
          "gtin8": {{ current_variant.barcode | json }}
        {%- elsif barcode_length == 12 -%},
          "gtin12": {{ current_variant.barcode | json }}
        {%- elsif barcode_length == 13 -%},
          "gtin13": {{ current_variant.barcode | json }}
        {%- elsif barcode_length == 14 -%},
          "gtin14": {{ current_variant.barcode | json }}
        {%- else -%},
          "gtin": {{ current_variant.barcode | json }}
        {%- endif -%}
      {%- endif %}{% if review_count > 0 and review_avg > 0 %},
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": {{ review_avg | json }},
        "reviewCount": {{ review_count | json }}
      }{% endif %},
      "offers": {
        "@type": "Offer",
        "url": {{ product_url | json }},
        "priceCurrency": {{ schema_currency | json }},
        "price": {{ current_variant.price | divided_by: 100.0 | json }}{% if current_variant.compare_at_price > current_variant.price and promo_valid_until != blank %},
        "priceValidUntil": {{ promo_valid_until | date: "%Y-%m-%d" | json }}{% endif %},
        "availability": "https://schema.org/{% if current_variant.available %}InStock{% else %}OutOfStock{% endif %}",
        "itemCondition": "https://schema.org/NewCondition"{% if current_variant.requires_shipping or return_policy_id != blank %},{% endif %}
        {% if current_variant.requires_shipping %}
        "shippingDetails": [
          {% if schema_country == 'PL' %}
          {
            "@type": "OfferShippingDetails",
            "shippingRate": {
              "@type": "MonetaryAmount",
              "value": 14,
              "currency": "PLN"
            },
            "shippingDestination": {
              "@type": "DefinedRegion",
              "addressCountry": "PL"
            },
            "deliveryTime": {
              "@type": "ShippingDeliveryTime",
              "handlingTime": {
                "@type": "QuantitativeValue",
                "minValue": 1,
                "maxValue": 2,
                "unitCode": "DAY"
              },
              "transitTime": {
                "@type": "QuantitativeValue",
                "minValue": 1,
                "maxValue": 2,
                "unitCode": "DAY"
              }
            },
            "shippingLabel": "Paczkomat InPost"
          },
          {
            "@type": "OfferShippingDetails",
            "shippingRate": {
              "@type": "MonetaryAmount",
              "value": 16,
              "currency": "PLN"
            },
            "shippingDestination": {
              "@type": "DefinedRegion",
              "addressCountry": "PL"
            },
            "deliveryTime": {
              "@type": "ShippingDeliveryTime",
              "handlingTime": {
                "@type": "QuantitativeValue",
                "minValue": 1,
                "maxValue": 2,
                "unitCode": "DAY"
              },
              "transitTime": {
                "@type": "QuantitativeValue",
                "minValue": 1,
                "maxValue": 2,
                "unitCode": "DAY"
              }
            },
            "shippingLabel": "Kurier InPost"
          },
          {
            "@type": "OfferShippingDetails",
            "shippingRate": {
              "@type": "MonetaryAmount",
              "value": 24,
              "currency": "PLN"
            },
            "shippingDestination": {
              "@type": "DefinedRegion",
              "addressCountry": "PL"
            },
            "deliveryTime": {
              "@type": "ShippingDeliveryTime",
              "handlingTime": {
                "@type": "QuantitativeValue",
                "minValue": 1,
                "maxValue": 2,
                "unitCode": "DAY"
              },
              "transitTime": {
                "@type": "QuantitativeValue",
                "minValue": 1,
                "maxValue": 2,
                "unitCode": "DAY"
              }
            },
            "shippingLabel": "Kurier InPost Pobranie"
          }
          {% else %}
          {
            "@type": "OfferShippingDetails",
            "shippingRate": {
              "@type": "MonetaryAmount",
              "value": 9.90,
              "currency": "EUR"
            },
            "shippingDestination": {
              "@type": "DefinedRegion",
              "addressCountry": {{ schema_country | json }}
            },
            "deliveryTime": {
              "@type": "ShippingDeliveryTime",
              "handlingTime": {
                "@type": "QuantitativeValue",
                "minValue": 1,
                "maxValue": 2,
                "unitCode": "DAY"
              },
              "transitTime": {
                "@type": "QuantitativeValue",
                "minValue": 1,
                "maxValue": 4,
                "unitCode": "DAY"
              }
            },
            "shippingLabel": "DHL"
          }
          {% endif %}
        ]{% if return_policy_id != blank %},{% endif %}
        {% endif %}
        {% if return_policy_id != blank %}
        "hasMerchantReturnPolicy": {
          "@id": {{ return_policy_id | json }}
        }
        {% endif %}
      }
    }
    {%- endif -%}
    {%- if product.metafields.custom.faq_schema != blank -%}
    ,{
      "@type": "FAQPage",
      "@id": {{ product_url | append: '#faq' | json }},
      "mainEntity": {{ product.metafields.custom.faq_schema.value | json }}
    }
    {%- endif -%}
  ]
}
</script>

{% schema %}
{
  "name": "Product information",
  "tag": "section",
  "class": "product-section",
	"settings": [
		{
			"type": "checkbox",
			"id": "enable_sticky_add_to_cart",
			"default": true,
			"label": "Show sticky add to cart"
		},
		{
			"type": "checkbox",
			"id": "show_taxes_included",
			"default": true,
			"label": "Show tax and shipping information",
			"info": "Tax and shipping information will be displayed if [taxes are included in the price](https://help.shopify.com/en/manual/taxes/location#include-taxes-in-product-prices) or [shipping policy](https://help.shopify.com/en/manual/checkout-settings/refund-privacy-tos#add-or-generate-store-policies) is added"
		},
		{
			"type": "header",
			"content": "Media"
		},
		{
			"type": "paragraph",
			"content": "Learn more about [media types](https://help.shopify.com/en/manual/products/product-media)"
		},
		{
      "type": "checkbox",
      "id": "display_slider_pagination",
      "default": true,
      "label": "Display pagination on mobile"
    },
		{
			"type": "select",
			"id": "media_aspect_ratio",
			"options": [
				{
					"value": "adapt",
					"label": "Adapt to image"
				},
				{
					"value": "square",
					"label": "Square"
				},
				{
					"value": "portrait",
					"label": "Portrait"
				},
				{
					"value": "landscape",
					"label": "Landscape"
				}
			],
			"default": "adapt",
			"label": "Image ratio"
		},
		{
      "type": "checkbox",
      "id": "display_captions",
      "default": true,
      "label": "Display captions"
    },
		{
      "type": "checkbox",
      "id": "hide_variants",
      "default": false,
      "label": "Hide unselected variants’ media",
			"info": "Media for the unselected variants will be hidden."
    },
		{
			"type": "checkbox",
			"id": "lightbox",
			"default": true,
			"label": "Enable image zoom"
		},
		{
      "type": "checkbox",
      "id": "enable_video_looping",
      "default": false,
      "label": "Enable video looping"
    }
  ],
  "blocks": [
		{
			"type": "@app"
		},
    {
      "type": "breadcrumbs",
      "name": "Breadcrumbs",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Shows the same breadcrumb trail as the standalone Breadcrumbs section (Home / Shop / Collection / Product), built from the current page — no settings needed."
        }
      ]
    },
    {
      "type": "label",
      "name": "Card labels",
      "settings": [
				{
					"type": "paragraph",
					"content": "Use a dynamic source to highlight a unique attribute by creating product label. [Learn more about product labels.](https://documentation.fuelthemes.net/kb/how-to-add-product-labels-in-distinctive-theme/)"
				}
      ]
    },
		{
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "Text block",
          "label": "Text"
        },

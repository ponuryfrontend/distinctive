{{ 'article.css' | asset_url | stylesheet_tag }}
<article class="blog-post-detail section-spacing-bottom">
	<div class="featured-image" {{ block.shopify_attributes }}>
		{%- liquid
			assign master_width = article.image.width | append: 'x' | append: article.image.height
		-%}
		{%- render 'responsive-image', image: article.image, sizes: master_width -%}

		<div class="post-title page-content-width" {{ block.shopify_attributes }}>
			<div class="post-meta-wrapper">
				{% if section.settings.article_show_date %}
				<aside class="post-meta">
					{{ article.published_at | time_tag: '%b %d, %Y' }}
				</aside>
				{% endif %}
				{% if section.settings.article_show_author %}
				<aside class="post-author">{{ article.author }}</aside>
				{% endif %}
			</div>
			<h1 class="entry-title">{{ article.title }}</h1>
		</div>
	</div>
	<div class="row">
		<div class="small-12 columns">
			<div class="page-content-width">
			{% for block in section.blocks %}
				{% if block.type == '@app' %}
					{% render block %}
				{% endif %}
				{% if block.type == 'content' %}
					<div class="post-content rte" {{ block.shopify_attributes }}>
						{{ article.content }}
					</div>
				{% endif %}
				{% if block.type == 'tags' %}
					{%- if article.tags.size > 0 -%}
					<footer class="article-tags" {{ block.shopify_attributes }}>
						{% for tag in article.tags %}
							<a href="{{ blog.url | escape }}/tagged/{{ tag | handle }}" class="tag-link">{{ tag }}</a>
						{% endfor %}
					</footer>
					{%- endif -%}
				{% endif %}
				{% if block.type == 'share' %}
					{% render 'social-share', share_label: true, share_title: article.title, share_permalink: article.url, share_image: article.image, block: block %}
				{% endif %}
				{% if block.type == 'post_navigation' %}
					{%- liquid
						assign current_found = false
						assign done = false

						for a in blog.articles
							if current_found and done == false
								assign next_article = a
								assign done = true
							endif
							unless done
								if a.id == article.id
									assign current_found = true
								else
									assign prev_article = a
								endif
							endunless
						endfor
					-%}
					{%- if next_article and prev_article -%}
						<div class="blog-post-detail--navigation">
							<div class="blog-post-detail--navigation-heading"><div>{{ 'blogs.article.continue_reading' | t }}</div></div>
							{%- if next_article -%}
								<div class="blog-post-detail--navigation-post">
									<div class="blog-post-detail--navigation-content">
										<h5><a href="{{ next_article.url }}" title="{{ next_article.title | escape }}">{{ next_article.title }}</a></h5>
										<a href="{{ next_article.url }}" title="{{ next_article.title | escape}}" class="text-button">{{ 'blogs.article.read_more' | t }}</a>
									</div>
									{%- if next_article.image -%}
									<div class="blog-post-detail--navigation-image">
										<a href="{{ next_article.url }}" title="{{ next_article.title | escape }}">
											{%- render 'responsive-image', image: next_article.image, sizes: '240x240' -%}
										</a>
									</div>
									{%- endif -%}
								</div>
							{% endif %}
							{%- if prev_article -%}
								<div class="blog-post-detail--navigation-post">
									<div class="blog-post-detail--navigation-content">
										<h5><a href="{{ prev_article.url }}" title="{{ prev_article.title | escape }}">{{ prev_article.title }}</a></h5>
										<a href="{{ prev_article.url }}" title="{{ prev_article.title | escape}}" class="text-button">{{ 'blogs.article.read_more' | t }}</a>
									</div>
									{%- if prev_article.image -%}
									<div class="blog-post-detail--navigation-image">
										<a href="{{ prev_article.url }}" title="{{ prev_article.title | escape }}">
											{%- render 'responsive-image', image: prev_article.image, sizes: '240x240' -%}
										</a>
									</div>
									{%- endif -%}
								</div>
							{% endif %}
						</div>
					{% endif %}
				{% endif %}
			{% endfor %}
			</div>
		</div>
	</div>
</article>
{% if blog.comments_enabled? %}
	{{ 'comments.css' | asset_url | stylesheet_tag }}
	<div class="row">
		<div class="small-12 columns">
				<div class="comments-wrapper page-content-width section-spacing-bottom">
					{% if article.comments_count > 0 %}
						<div class="comments-container page-content-width" id="comments">
							<div class="comments-title h3">{{ 'blogs.article.comments_html' | t: count: article.comments_count, title: article.title }}</div>
							<ul class="commentlist">
								{% paginate article.comments by 5 %}
									{% for comment in article.comments %}
										<li class="comment">
			              <img data-src="https://www.gravatar.com/avatar/{{ comment.email | remove: ' ' | strip_newlines | downcase | md5 }}?s=200" class="avatar lazyload" alt="{{ comment.author | escape }}" width="100" height="100" />
										<div class="comment-body">
			                <div class="comment-author">
			                  <cite class="fn">{{ comment.author }}</cite>
			                </div>
											<div class="comment-text">
				                {{ comment.content }}
											</div>
											<a href="{{ comment.url }}" class="comment-meta">{{ comment.created_at | date: "%B %d, %Y" }}</a>
			              </div>
			            </li>
									{% endfor %}
									{% if paginate.pages > 1 %}
										{{ paginate | default_pagination }}
									{% endif %}
								{% endpaginate %}
							</ul>
						</div>
					{% endif %}
					<div class="respond-container page-content-width">
						<div class="comment-respond">
							{% form 'new_comment', article %}
								{%- liquid
									assign post_message = 'blogs.article.success'
									if blog.moderated? and comment.status == 'unapproved'
										assign post_message = 'blogs.article.success_moderated'
									endif
								-%}
								<div class="comment-reply-title--container">
									<div id="reply-title" class="h3 comment-reply-title">{{ 'blogs.article.comment_form_title' | t }}</div>
									<p class="comment-notes">{{ 'blogs.article.comment_form_note' | t }}.</p>
								</div>
								{% if form.errors %}
									<div class="form-notification error">
										{% render 'svg-icons' with 'thb-error' %} {{ form.errors | default_errors }}
									</div>
								{%- elsif form.posted_successfully? -%}
									<div class="form-notification success">
										{% render 'svg-icons' with 'thb-success' %} {{ post_message | t }}
									</div>
								{%- endif -%}
								<div class="comment-form-fields">
									<div class="field">
										<textarea name="comment[body]" class="full {% if form.errors contains 'body' %}invalid{% endif %}" id="CommentBody" placeholder="{{ 'blogs.article.message' | t }}">{{ form.body }}</textarea>
										<label>{{ 'blogs.article.message' | t }}</label>
									</div>
									<div class="field">
										<input type="text" class="full {% if form.errors contains 'author' %}invalid{% endif %}" name="comment[author]" id="CommentAuthor" value="{{ form.author }}" autocapitalize="words" placeholder="{{ 'blogs.article.name' | t }}">
										<label>{{ 'blogs.article.name' | t }}</label>
									</div>
									<div class="field">
										<input type="email" class="full {% if form.errors contains 'email' %}invalid{% endif %}" name="comment[email]" id="CommentEmail" value="{{ form.email }}" autocorrect="off" autocapitalize="off" placeholder="{{ 'blogs.article.email' | t }}">
										<label>{{ 'blogs.article.email' | t }}</label>
									</div>
								</div>
								<input class="button" type="submit" value="{{ 'blogs.article.post' | t | escape }}">
							{% endform %}
						</div>
					</div>
				</div>
		</div>
	</div>
{% endif %}
{%- liquid
  assign article_schema_url = shop.url | append: article.url
  if article.excerpt != blank
    assign article_schema_description = article.excerpt | strip_html | strip_newlines | strip
  else
    assign article_schema_description = article.content | strip_html | strip_newlines | strip | truncatewords: 40
  endif
-%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "@id": {{ article_schema_url | append: '#article' | json }},
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": {{ article_schema_url | json }}
    },
    "url": {{ article_schema_url | json }},
    "isPartOf": {
      "@id": {{ shop.url | append: '#website' | json }}
    },
    "inLanguage": {{ request.locale.iso_code | json }},
    "headline": {{ article.title | strip | json }},
    "description": {{ article_schema_description | json }},
    "articleBody": {{ article.content | replace: '</p>', ' </p>' | strip_html | strip_newlines | strip | json }}{% if article.image %},
    "image": [
      {%- assign image_ratios = '16:9,4:3,1:1' | split: ',' -%}
      {%- for ratio in image_ratios -%}
        {%- liquid
          assign ratio_parts = ratio | split: ':'
          assign ratio_w = ratio_parts[0] | times: 1.0
          assign ratio_h = ratio_parts[1] | times: 1.0
          assign crop_width_from_height = article.image.height | times: ratio_w | divided_by: ratio_h | floor
          assign crop_width = 1200 | at_most: article.image.width | at_most: crop_width_from_height
          assign crop_height = crop_width | times: ratio_h | divided_by: ratio_w | round
        -%}
      {
        "@type": "ImageObject",
        "url": {{ article.image | image_url: width: crop_width, height: crop_height, crop: 'center' | prepend: 'https:' | json }},
        "width": {{ crop_width | json }},
        "height": {{ crop_height | json }}
      }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]{% endif %},
    "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
    "dateCreated": {{ article.created_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
    "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
    "author": {
      "@type": "Person",
      "@id": "https://nudyess.com/#sandra-do-manh",
      "name": "Sandra Do Manh",
      "url": "https://nudyess.com/pages/filozofia-marki-nudyess#sandra-do-manh"
    },
    "publisher": {
      "@id": {{ shop.url | append: '#organization' | json }}
    }{% if article.tags.size > 0 %},
    "keywords": {{ article.tags | join: ', ' | json }}{% endif %}
  }
</script>
{%- if template.name == 'article' -%}
  {%- assign article_url = shop.url | append: article.url -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "@id": {{ article_url | append: '#breadcrumb' | json }},
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Strona główna",
          "item": {{ shop.url | append: routes.root_url | json }}
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ blog.title | strip | json }},
          "item": {{ shop.url | append: blog.url | json }}
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": {{ article.title | strip | json }},
          "item": {{ article_url | json }}
        }
      ]
    }
  </script>
{%- endif -%}
{%- if article.metafields.custom.seo_faq != blank -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "@id": {{ shop.url | append: article.url | append: '#faq' | json }},
      "isPartOf": {
        "@id": {{ article_schema_url | append: '#article' | json }}
      },
      "mainEntity": {{ article.metafields.custom.seo_faq.value | json }}
    }
  </script>
{%- endif -%}
{% schema %}
  {
		"name": "Blog post",
		"class": "article-section",
    "settings": [
			{
				"type": "header",
				"content": "Settings"
			},
			{
				"type": "checkbox",
				"id": "article_show_date",
				"label": "Show date",
				"default": true
			},
			{
				"type": "checkbox",
				"id": "article_show_author",
				"label": "Show author",
				"default": true
			}
    ],
		"blocks": [
			{
	      "type": "@app"
	    },
			{
        "type": "content",
        "name": "Content",
	      "limit": 1
      },
			{
        "type": "tags",
        "name": "Tags",
	      "limit": 1
      },
			{
				"type": "share",
				"name": "Share",
				"limit": 1,
				"settings": [
					{
						"type": "paragraph",
						"content": "If you include a link in social media posts, the page’s featured image will be shown as the preview image. [Learn more](https://help.shopify.com/en/manual/online-store/images/showing-social-media-thumbnail-images)."
					},
					{
						"type": "paragraph",
						"content": "A store title and description are included with the preview image. [Learn more](https://help.shopify.com/en/manual/promoting-marketing/seo/adding-keywords#set-a-title-and-description-for-your-online-store)."
					}
				]
			},
			{
        "type": "post_navigation",
        "name": "Article navigation",
	      "limit": 1
      }
    ]
  }
{% endschema %}

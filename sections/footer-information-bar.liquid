{%- liquid
  assign show_social_links = section.settings.show_social_links
-%}
<link rel="stylesheet" href="{{ 'footer-information-bar.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'footer-information-bar.css' | asset_url | stylesheet_tag }}</noscript>
<div class="footer-information-bar">
  <side-panel-links class="side-panel-links">
    {%- for block in section.blocks -%}
      {%- if block.settings.side_panel_label != '' -%}
      <button class="side-panel-links--link no-js-hidden" data-id="#side-panel-{{ section.id }}-{{ block.id}}">{% render 'svg-icons-inline', icon: block.settings.side_panel_icon %}<span class="text-button">{{ block.settings.side_panel_label }}</span></button>
      {%- endif -%}
    {%- endfor -%}
  </side-panel-links>
  {%- if section.blocks.size > 0 -%}
  <script src="{{ 'side-panel-links.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}
  {%- if show_social_links -%}
    {%- render 'social-links' -%}
  {%- endif -%}
</div>
{%- for block in section.blocks -%}
<div class="side-panel side-panel-links-drawer" tabindex="-1" id="side-panel-{{ section.id }}-{{ block.id }}">
	<div class="side-panel-inner">
		<div class="side-panel-header">
			<div>
				<span class="h5 body-font">{{ block.settings.side_panel_label }}</span>
				<side-panel-close class="side-panel-close" tabindex="0">{%- render 'svg-icons' with 'close' -%}</side-panel-close>
			</div>
		</div>
		<div class="side-panel-content">
      <div class="rte">
        {{ block.settings.side_panel_content }}
        {{ block.settings.side_panel_page.content }}
      </div>
		</div>
	</div>
</div>
{%- endfor -%}
{% schema %}

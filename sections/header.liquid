    if social_links != blank
      assign social_links = social_links | append: ','
    endif
    assign social_links = social_links | append: settings.social_wechat_link | json
  endif
-%}

{%- if request.page_type == 'index' -%}
  {%- assign search_action_target = request.origin | append: routes.search_url | append: "?q=%7Bsearch_term_string%7D" -%}
{%- endif -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "OnlineStore",
      "@id": {{ shop.url | append: "#organization" | json }},
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }}{% if section.settings.logo %},
      "logo": {{ section.settings.logo | image_url: width: section.settings.logo.width | prepend: "https:" | json }}{% endif %},
      "sameAs": [
        {%- assign first_social = true -%}
        {%- if settings.social_facebook_link != blank -%}
          {{ settings.social_facebook_link | json }}{%- assign first_social = false -%}
        {%- endif -%}
        {%- if settings.social_instagram_link != blank -%}
          {%- unless first_social -%},{%- endunless -%}{{ settings.social_instagram_link | json }}{%- assign first_social = false -%}
        {%- endif -%}
        {%- if settings.social_pinterest_link != blank -%}
          {%- unless first_social -%},{%- endunless -%}{{ settings.social_pinterest_link | json }}{%- assign first_social = false -%}
        {%- endif -%}
        {%- if settings.social_tiktok_link != blank -%}
          {%- unless first_social -%},{%- endunless -%}{{ settings.social_tiktok_link | json }}{%- assign first_social = false -%}
        {%- endif -%}
        {%- if settings.social_youtube_link != blank -%}
          {%- unless first_social -%},{%- endunless -%}{{ settings.social_youtube_link | json }}{%- assign first_social = false -%}
        {%- endif -%}
        {%- if settings.social_twitter_link != blank -%}
          {%- unless first_social -%},{%- endunless -%}{{ settings.social_twitter_link | json }}{%- assign first_social = false -%}
        {%- endif -%}
        {%- if settings.social_linkedin_link != blank -%}
          {%- unless first_social -%},{%- endunless -%}{{ settings.social_linkedin_link | json }}{%- assign first_social = false -%}
        {%- endif -%}
      ],
      "hasMerchantReturnPolicy": [
        {%- for country in localization.available_countries -%}
          {
            "@id": {{ shop.url | append: "#return-policy-" | append: country.iso_code | downcase | json }}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    },
    {
      "@type": "WebSite",
      "@id": {{ shop.url | append: "#website" | json }},
      "url": {{ shop.url | json }},
      "name": {{ shop.name | json }}{% if request.page_type == 'index' %},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ search_action_target | json }},
        "query-input": "required name=search_term_string"
      }{% endif %}
    }{%- for country in localization.available_countries -%},
    {
      "@type": "MerchantReturnPolicy",
      "@id": {{ shop.url | append: "#return-policy-" | append: country.iso_code | downcase | json }},
      "name": {{ "Return policy - " | append: country.name | json }},
      "applicableCountry": {{ country.iso_code | json }},
      "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
      "merchantReturnDays": 14,
      "returnMethod": "https://schema.org/ReturnByMail",
      "returnFees": "https://schema.org/ReturnFeesCustomerResponsibility",
      "merchantReturnLink": {{ shop.url | append: "/policies/refund-policy" | json }}
    }{%- endfor -%}
  ]
}
</script>


{{- 'product-grid.css' | asset_url | stylesheet_tag -}}
{%- liquid
	assign section_heading = section.settings.heading
	assign section_description = section.settings.description
	assign mobile_swipe = section.settings.mobile_swipe
	assign disable_top_spacing = section.settings.disable_top_spacing
	assign disable_bottom_spacing = section.settings.disable_bottom_spacing
	assign product_id = product.id
	if template == 'cart' and cart != empty
		assign product_id = cart.items[0].product_id
	endif

	assign product_limit = section.settings.product_limit | default: 4
	assign carousel_gap_desktop = section.settings.carousel_gap_desktop | default: 0

	assign small_heading = section.settings.small_heading
	assign small_heading_color = section.settings.small_heading_color
	assign small_heading_align_d = section.settings.small_heading_align_desktop
	assign small_heading_align_m = section.settings.small_heading_align_mobile
	assign small_heading_font_d = section.settings.small_heading_font_desktop
	assign small_heading_font_m = section.settings.small_heading_font_mobile
	assign small_heading_font_picker_d = section.settings.small_heading_font_desktop_picker
	assign small_heading_font_picker_m = section.settings.small_heading_font_mobile_picker
	assign small_heading_size_d = section.settings.small_heading_size_desktop
	assign small_heading_size_m = section.settings.small_heading_size_mobile
	assign small_heading_case_d = section.settings.small_heading_case_desktop
	assign small_heading_case_m = section.settings.small_heading_case_mobile

	assign heading_color = section.settings.heading_color
	assign heading_align_d = section.settings.heading_align_desktop
	assign heading_align_m = section.settings.heading_align_mobile
	assign heading_font_d = section.settings.heading_font_desktop
	assign heading_font_m = section.settings.heading_font_mobile
	assign heading_font_picker_d = section.settings.heading_font_desktop_picker
	assign heading_font_picker_m = section.settings.heading_font_mobile_picker
	assign heading_size_d = section.settings.heading_size_desktop
	assign heading_size_m = section.settings.heading_size_mobile
	assign heading_case_d = section.settings.heading_case_desktop
	assign heading_case_m = section.settings.heading_case_mobile

	assign description_color = section.settings.description_color
	assign description_align_d = section.settings.description_align_desktop
	assign description_align_m = section.settings.description_align_mobile
	assign description_font_d = section.settings.description_font_desktop
	assign description_font_m = section.settings.description_font_mobile
	assign description_font_picker_d = section.settings.description_font_desktop_picker
	assign description_font_picker_m = section.settings.description_font_mobile_picker
	assign description_case_d = section.settings.description_case_desktop
	assign description_case_m = section.settings.description_case_mobile
-%}
{%- capture custom_font_faces -%}
	{%- if small_heading_font_d == 'custom' and small_heading_font_picker_d -%}{{ small_heading_font_picker_d | font_face: font_display: 'swap' }}{%- endif -%}
	{%- if small_heading_font_m == 'custom' and small_heading_font_picker_m -%}{{ small_heading_font_picker_m | font_face: font_display: 'swap' }}{%- endif -%}
	{%- if heading_font_d == 'custom' and heading_font_picker_d -%}{{ heading_font_picker_d | font_face: font_display: 'swap' }}{%- endif -%}
	{%- if heading_font_m == 'custom' and heading_font_picker_m -%}{{ heading_font_picker_m | font_face: font_display: 'swap' }}{%- endif -%}
	{%- if description_font_d == 'custom' and description_font_picker_d -%}{{ description_font_picker_d | font_face: font_display: 'swap' }}{%- endif -%}
	{%- if description_font_m == 'custom' and description_font_picker_m -%}{{ description_font_picker_m | font_face: font_display: 'swap' }}{%- endif -%}
{%- endcapture -%}
{%- capture small_heading_classes -%}
	{%- if small_heading_font_d == 'heading' or small_heading_font_d == 'body' or small_heading_font_d == 'custom' %} rec-kicker--font-desktop{% endif -%}
	{%- if small_heading_font_m == 'heading' or small_heading_font_m == 'body' or small_heading_font_m == 'custom' %} rec-kicker--font-mobile{% endif -%}
	{%- if small_heading_size_d > 0 %} rec-kicker--size-desktop{% endif -%}
	{%- if small_heading_size_m > 0 %} rec-kicker--size-mobile{% endif -%}
	{%- if small_heading_case_d == 'uppercase' %} rec-kicker--case-upper-desktop{% elsif small_heading_case_d == 'lowercase' %} rec-kicker--case-lower-desktop{% elsif small_heading_case_d == 'capitalize' %} rec-kicker--case-capitalize-desktop{% elsif small_heading_case_d == 'none' %} rec-kicker--case-normal-desktop{% endif -%}
	{%- if small_heading_case_m == 'uppercase' %} rec-kicker--case-upper-mobile{% elsif small_heading_case_m == 'lowercase' %} rec-kicker--case-lower-mobile{% elsif small_heading_case_m == 'capitalize' %} rec-kicker--case-capitalize-mobile{% elsif small_heading_case_m == 'none' %} rec-kicker--case-normal-mobile{% endif -%}
	{%- if small_heading_align_d != blank %} rec-kicker--align-desktop{% endif -%}
	{%- if small_heading_align_m != blank %} rec-kicker--align-mobile{% endif -%}
{%- endcapture -%}
{%- capture small_heading_style -%}
	{%- if small_heading_font_d == 'heading' -%}--rec-kicker-font-desktop: {{ settings.heading_font.family }}, {{ settings.heading_font.fallback_families }};{%- elsif small_heading_font_d == 'body' -%}--rec-kicker-font-desktop: {{ settings.body_font.family }}, {{ settings.body_font.fallback_families }};{%- elsif small_heading_font_d == 'custom' and small_heading_font_picker_d -%}--rec-kicker-font-desktop: {{ small_heading_font_picker_d.family }}, {{ small_heading_font_picker_d.fallback_families }};{%- endif -%}
	{%- if small_heading_font_m == 'heading' -%}--rec-kicker-font-mobile: {{ settings.heading_font.family }}, {{ settings.heading_font.fallback_families }};{%- elsif small_heading_font_m == 'body' -%}--rec-kicker-font-mobile: {{ settings.body_font.family }}, {{ settings.body_font.fallback_families }};{%- elsif small_heading_font_m == 'custom' and small_heading_font_picker_m -%}--rec-kicker-font-mobile: {{ small_heading_font_picker_m.family }}, {{ small_heading_font_picker_m.fallback_families }};{%- endif -%}
	{%- if small_heading_size_d > 0 -%}--rec-kicker-size-desktop: {{ small_heading_size_d }}px;{%- endif -%}
	{%- if small_heading_size_m > 0 -%}--rec-kicker-size-mobile: {{ small_heading_size_m }}px;{%- endif -%}
	{%- if small_heading_align_d != blank -%}--rec-kicker-align-desktop: {{ small_heading_align_d }};{%- endif -%}
	{%- if small_heading_align_m != blank -%}--rec-kicker-align-mobile: {{ small_heading_align_m }};{%- endif -%}
	{%- if small_heading_color != blank -%}color: {{ small_heading_color }}; opacity: 1;{%- endif -%}
{%- endcapture -%}
{%- capture heading_classes -%}
	{%- if heading_font_d == 'heading' or heading_font_d == 'body' or heading_font_d == 'custom' %} rec-heading--font-desktop{% endif -%}
	{%- if heading_font_m == 'heading' or heading_font_m == 'body' or heading_font_m == 'custom' %} rec-heading--font-mobile{% endif -%}
	{%- if heading_size_d > 0 %} rec-heading--size-desktop{% endif -%}
	{%- if heading_size_m > 0 %} rec-heading--size-mobile{% endif -%}
	{%- if heading_case_d == 'uppercase' %} rec-heading--case-upper-desktop{% elsif heading_case_d == 'lowercase' %} rec-heading--case-lower-desktop{% elsif heading_case_d == 'capitalize' %} rec-heading--case-capitalize-desktop{% elsif heading_case_d == 'none' %} rec-heading--case-normal-desktop{% endif -%}
	{%- if heading_case_m == 'uppercase' %} rec-heading--case-upper-mobile{% elsif heading_case_m == 'lowercase' %} rec-heading--case-lower-mobile{% elsif heading_case_m == 'capitalize' %} rec-heading--case-capitalize-mobile{% elsif heading_case_m == 'none' %} rec-heading--case-normal-mobile{% endif -%}
	{%- if heading_align_d != blank %} rec-heading--align-desktop{% endif -%}
	{%- if heading_align_m != blank %} rec-heading--align-mobile{% endif -%}
{%- endcapture -%}
{%- capture heading_style -%}
	{%- if heading_font_d == 'heading' -%}--rec-heading-font-desktop: {{ settings.heading_font.family }}, {{ settings.heading_font.fallback_families }};{%- elsif heading_font_d == 'body' -%}--rec-heading-font-desktop: {{ settings.body_font.family }}, {{ settings.body_font.fallback_families }};{%- elsif heading_font_d == 'custom' and heading_font_picker_d -%}--rec-heading-font-desktop: {{ heading_font_picker_d.family }}, {{ heading_font_picker_d.fallback_families }};{%- endif -%}
	{%- if heading_font_m == 'heading' -%}--rec-heading-font-mobile: {{ settings.heading_font.family }}, {{ settings.heading_font.fallback_families }};{%- elsif heading_font_m == 'body' -%}--rec-heading-font-mobile: {{ settings.body_font.family }}, {{ settings.body_font.fallback_families }};{%- elsif heading_font_m == 'custom' and heading_font_picker_m -%}--rec-heading-font-mobile: {{ heading_font_picker_m.family }}, {{ heading_font_picker_m.fallback_families }};{%- endif -%}
	{%- if heading_size_d > 0 -%}--rec-heading-size-desktop: {{ heading_size_d }}px;{%- endif -%}
	{%- if heading_size_m > 0 -%}--rec-heading-size-mobile: {{ heading_size_m }}px;{%- endif -%}
	{%- if heading_align_d != blank -%}--rec-heading-align-desktop: {{ heading_align_d }};{%- endif -%}
	{%- if heading_align_m != blank -%}--rec-heading-align-mobile: {{ heading_align_m }};{%- endif -%}
	{%- if heading_color != blank -%}color: {{ heading_color }};{%- endif -%}
{%- endcapture -%}
{%- capture description_classes -%}
	{%- if description_font_d == 'heading' or description_font_d == 'body' or description_font_d == 'custom' %} rec-description--font-desktop{% endif -%}
	{%- if description_font_m == 'heading' or description_font_m == 'body' or description_font_m == 'custom' %} rec-description--font-mobile{% endif -%}
	{%- if description_case_d == 'uppercase' %} rec-description--case-upper-desktop{% elsif description_case_d == 'lowercase' %} rec-description--case-lower-desktop{% elsif description_case_d == 'capitalize' %} rec-description--case-capitalize-desktop{% elsif description_case_d == 'none' %} rec-description--case-normal-desktop{% endif -%}
	{%- if description_case_m == 'uppercase' %} rec-description--case-upper-mobile{% elsif description_case_m == 'lowercase' %} rec-description--case-lower-mobile{% elsif description_case_m == 'capitalize' %} rec-description--case-capitalize-mobile{% elsif description_case_m == 'none' %} rec-description--case-normal-mobile{% endif -%}
	{%- if description_align_d != blank %} rec-description--align-desktop{% endif -%}
	{%- if description_align_m != blank %} rec-description--align-mobile{% endif -%}
{%- endcapture -%}
{%- capture description_style -%}
	{%- if description_font_d == 'heading' -%}--rec-description-font-desktop: {{ settings.heading_font.family }}, {{ settings.heading_font.fallback_families }};{%- elsif description_font_d == 'body' -%}--rec-description-font-desktop: {{ settings.body_font.family }}, {{ settings.body_font.fallback_families }};{%- elsif description_font_d == 'custom' and description_font_picker_d -%}--rec-description-font-desktop: {{ description_font_picker_d.family }}, {{ description_font_picker_d.fallback_families }};{%- endif -%}
	{%- if description_font_m == 'heading' -%}--rec-description-font-mobile: {{ settings.heading_font.family }}, {{ settings.heading_font.fallback_families }};{%- elsif description_font_m == 'body' -%}--rec-description-font-mobile: {{ settings.body_font.family }}, {{ settings.body_font.fallback_families }};{%- elsif description_font_m == 'custom' and description_font_picker_m -%}--rec-description-font-mobile: {{ description_font_picker_m.family }}, {{ description_font_picker_m.fallback_families }};{%- endif -%}
	{%- if description_align_d != blank -%}--rec-description-align-desktop: {{ description_align_d }};{%- endif -%}
	{%- if description_align_m != blank -%}--rec-description-align-mobile: {{ description_align_m }};{%- endif -%}
	{%- if description_color != blank -%}color: {{ description_color }};{%- endif -%}
{%- endcapture -%}
{%- if custom_font_faces != blank -%}
<style>{{ custom_font_faces }}</style>
{%- endif -%}
<div class="row full-width-row">
	<div class="small-12 columns">
		<product-recommendations class="product-recommendations product-recommendations--cart {% if mobile_swipe %} swipe-on-mobile{% endif %} section-spacing{% if disable_top_spacing %} section-spacing--disable-top{% endif %}{% if disable_bottom_spacing %} section-spacing--disable-bottom{% endif %}" data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product_id }}&limit={{ product_limit }}">
			{% if recommendations.performed and recommendations.products_count > 0 %}
				{%- assign is_carousel = false -%}
				{%- if recommendations.products_count > 4 -%}
					{%- assign is_carousel = true -%}
				{%- endif -%}
				<div class="product-recommendations--header">
					<div class="product-recommendations--header-content">
						{%- if small_heading != blank -%}
							<div class="product-recommendations--kicker{{ small_heading_classes }}"{% if small_heading_style != blank %} style="{{ small_heading_style | strip_newlines | strip }}"{% endif %}>{{ small_heading }}</div>
						{%- endif -%}
						{%- if section_heading != blank -%}
							<h2 class="product-recommendations--main-heading{{ heading_classes }}"{% if heading_style != blank %} style="{{ heading_style | strip_newlines | strip }}"{% endif %}>{{ section_heading | replace_first: '|', '<span class="body-font">' | replace: '|', '</span>' }}</h2>
						{%- endif -%}
						{%- if section_description != blank -%}
							<div class="rte product-recommendations--description{{ description_classes }}"{% if description_style != blank %} style="{{ description_style | strip_newlines | strip }}"{% endif %}>{{ section_description }}</div>
						{%- endif -%}
					</div>
					{%- if is_carousel -%}
					<div class="product-recommendations--pager">
						<div class="flickity-nav flickity-prev" tabindex="0">{%- render 'svg-icons' with 'carousel-prev' -%}</div>
						<span class="product-recommendations--pager-count"><span class="product-recommendations--pager-current">1</span> / <span class="product-recommendations--pager-total">1</span></span>
						<div class="flickity-nav flickity-next" tabindex="0">{%- render 'svg-icons' with 'carousel-next' -%}</div>
					</div>
					{%- endif -%}
				</div>
				{%- if is_carousel -%}
					<slide-show class="product-recommendations--carousel carousel--paged products carousel" data-align="left" style="--rec-carousel-gap-desktop: {{ carousel_gap_desktop }}px;">
						{%- for recommendation in recommendations.products -%}
							<div class="carousel__slide">
								{% render 'product-card', product_card_product: recommendation %}
							</div>
						{%- endfor -%}
					</slide-show>
				{%- else -%}
					<ul class="products collection row small-up-{{ settings.product_card_columns }} medium-up-4 no-padding">
						{% for recommendation in recommendations.products %}
							<li class="columns">
								{% render 'product-card', product_card_product: recommendation %}
							</li>
						{% endfor %}
					</ul>
				{%- endif -%}
			{% endif %}
		</product-recommendations>
	</div>
</div>
{%- unless settings.cart_recommendations -%}
<script src="{{ 'product-recommendations.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}
{% schema %}
	{
		"name": "Product recommendations",
		"class": "product-recommendations-section",
		"settings": [
		{
			"type": "paragraph",
			"content": "Customize product recommendations with Search and Discovery app. [Learn more](https://help.shopify.com/en/manual/online-store/search-and-discovery/product-recommendations)."
		},
		{
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may |also like|",
			"info": "Wrap your text between | to use body font. For example: Heading |continued|"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Describe your featured collection here</p>"
    },
		{
			"type": "checkbox",
			"id": "mobile_swipe",
			"default": true,
			"label": "Enable swipe on mobile"
		},
		{
			"type": "header",
			"content": "Products"
		},
		{
			"type": "range",
			"id": "product_limit",
			"min": 2,
			"max": 10,
			"step": 1,
			"default": 4,
			"label": "Number of products to show",
			"info": "More than 4 switches to a swipeable carousel with page arrows on desktop. Shopify's recommendations API caps this at 10."
		},
		{
			"type": "range",
			"id": "carousel_gap_desktop",
			"min": 0,
			"max": 60,
			"step": 1,
			"unit": "px",
			"default": 0,
			"label": "Gap between images (desktop)",
			"info": "Only applies to the carousel shown when there are more than 4 products."
		},
		{
			"type": "header",
			"content": "Small heading"
		},
		{
			"type": "text",
			"id": "small_heading",
			"label": "Small heading",
			"info": "Optional label shown above the heading. Leave blank to hide."
		},
		{
			"type": "color",
			"id": "small_heading_color",
			"label": "Color"
		},
		{
			"type": "select",
			"id": "small_heading_align_desktop",
			"label": "Alignment (desktop)",
			"options": [
				{ "value": "", "label": "Theme default" },
				{ "value": "left", "label": "Left" },
				{ "value": "center", "label": "Center" },
				{ "value": "right", "label": "Right" }
			],
			"default": ""
		},
		{
			"type": "select",
			"id": "small_heading_align_mobile",
			"label": "Alignment (mobile)",
			"options": [
				{ "value": "", "label": "Theme default" },
				{ "value": "left", "label": "Left" },
				{ "value": "center", "label": "Center" },
				{ "value": "right", "label": "Right" }
			],
			"default": ""
		},
		{
			"type": "select",
			"id": "small_heading_font_desktop",
			"label": "Font (desktop)",
			"options": [
				{ "value": "", "label": "Theme default" },
				{ "value": "heading", "label": "Heading font" },
				{ "value": "body", "label": "Body font" },
				{ "value": "custom", "label": "Custom font…" }
			],
			"default": ""
		},
		{
			"type": "font_picker",
			"id": "small_heading_font_desktop_picker",
			"label": "Custom font (desktop)",
			"info": "Used when \"Font (desktop)\" above is set to Custom font.",
			"default": "archivo_narrow_n4",
			"visible_if": "{{ section.settings.small_heading_font_desktop == 'custom' }}"
		},
		{
			"type": "select",
			"id": "small_heading_font_mobile",
			"label": "Font (mobile)",
			"options": [
				{ "value": "", "label": "Theme default" },
				{ "value": "heading", "label": "Heading font" },
				{ "value": "body", "label": "Body font" },
				{ "value": "custom", "label": "Custom font…" }
			],
			"default": ""
		},
		{
			"type": "font_picker",
			"id": "small_heading_font_mobile_picker",
			"label": "Custom font (mobile)",
			"info": "Used when \"Font (mobile)\" above is set to Custom font.",
			"default": "archivo_narrow_n4",
			"visible_if": "{{ section.settings.small_heading_font_mobile == 'custom' }}"
		},
		{
			"type": "range",
			"id": "small_heading_size_desktop",
			"min": 0,
			"max": 40,
			"step": 1,
			"unit": "px",
			"label": "Font size (desktop)",
			"info": "0 uses the theme default size.",
			"default": 0
		},
		{
			"type": "range",
			"id": "small_heading_size_mobile",
			"min": 0,
			"max": 40,
			"step": 1,
			"unit": "px",
			"label": "Font size (mobile)",
			"info": "0 uses the theme default size.",
			"default": 0
		},
		{
			"type": "select",
			"id": "small_heading_case_desktop",
			"label": "Letter case (desktop)",
			"options": [
				{ "value": "", "label": "Theme default" },
				{ "value": "uppercase", "label": "UPPERCASE" },
				{ "value": "lowercase", "label": "lowercase" },
				{ "value": "capitalize", "label": "Capitalize" },
				{ "value": "none", "label": "As typed" }
			],
			"default": ""
		},
		{
			"type": "select",
			"id": "small_heading_case_mobile",
			"label": "Letter case (mobile)",
			"options": [
				{ "value": "", "label": "Theme default" },
				{ "value": "uppercase", "label": "UPPERCASE" },
				{ "value": "lowercase", "label": "lowercase" },
				{ "value": "capitalize", "label": "Capitalize" },
				{ "value": "none", "label": "As typed" }
			],
			"default": ""
		},
		{
			"type": "header",
			"content": "Heading typography"
		},
		{
			"type": "color",
			"id": "heading_color",
			"label": "Color"
		},
		{
			"type": "select",
			"id": "heading_align_desktop",
			"label": "Alignment (desktop)",
			"options": [
				{ "value": "", "label": "Theme default" },
				{ "value": "left", "label": "Left" },
				{ "value": "center", "label": "Center" },
				{ "value": "right", "label": "Right" }
			],
			"default": ""
		},
		{
			"type": "select",
			"id": "heading_align_mobile",
			"label": "Alignment (mobile)",
			"options": [
				{ "value": "", "label": "Theme default" },
				{ "value": "left", "label": "Left" },
				{ "value": "center", "label": "Center" },
				{ "value": "right", "label": "Right" }
			],
			"default": ""
		},
		{
			"type": "select",
			"id": "heading_font_desktop",
			"label": "Font (desktop)",
			"options": [
				{ "value": "", "label": "Theme default" },
				{ "value": "heading", "label": "Heading font" },
				{ "value": "body", "label": "Body font" },
				{ "value": "custom", "label": "Custom font…" }
			],
			"default": ""
		},
		{
			"type": "font_picker",
			"id": "heading_font_desktop_picker",
			"label": "Custom font (desktop)",
			"info": "Used when \"Font (desktop)\" above is set to Custom font.",
			"default": "archivo_narrow_n4",
			"visible_if": "{{ section.settings.heading_font_desktop == 'custom' }}"
		},
		{
			"type": "select",
			"id": "heading_font_mobile",
			"label": "Font (mobile)",
			"options": [
				{ "value": "", "label": "Theme default" },
				{ "value": "heading", "label": "Heading font" },
				{ "value": "body", "label": "Body font" },
				{ "value": "custom", "label": "Custom font…" }
			],
			"default": ""
		},
		{
			"type": "font_picker",
			"id": "heading_font_mobile_picker",
			"label": "Custom font (mobile)",
			"info": "Used when \"Font (mobile)\" above is set to Custom font.",
			"default": "archivo_narrow_n4",
			"visible_if": "{{ section.settings.heading_font_mobile == 'custom' }}"
		},
		{
